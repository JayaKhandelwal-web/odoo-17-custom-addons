                <!-- Custom CSS for Marquee -->
                <style>
                    .fleet-marquee-container {
                        overflow: hidden;
                        position: relative;
                        width: 100%;
                        padding: 20px 0;
                    }

                    .fleet-marquee-wrapper {
                        display: flex;
                        width: fit-content;
                        animation: marquee 30s linear infinite;
                    }

                    .fleet-marquee-wrapper:hover {
                        animation-play-state: paused;
                    }

                    .fleet-card-marquee {
                        flex: 0 0 380px;
                        margin: 0 15px;
                        background: white;
                        border-radius: 1rem;
                        overflow: hidden;
                        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                        transition: transform 0.3s ease, box-shadow 0.3s ease;
                    }

                    .fleet-card-marquee:hover {
                        transform: translateY(-10px);
                        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
                    }

                    @keyframes marquee {
                        0% {
                            transform: translateX(0);
                        }
                        100% {
                            transform: translateX(-50%);
                        }
                    }

                    .fleet-image {
                        position: relative;
                        height: 250px;
                        overflow: hidden;
                    }

                    .fleet-image img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                    }

                    .fleet-placeholder {
                        width: 100%;
                        height: 100%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    }

                    .fleet-badge {
                        z-index: 10;
                    }

                    .fleet-content {
                        padding: 1.5rem;
                    }

                    .fleet-title {
                        font-size: 1.25rem;
                        margin-bottom: 0.5rem;
                        color: #2c3e50;
                    }

                    .fleet-category {
                        font-size: 0.95rem;
                        color: #3498db;
                        margin-bottom: 0.75rem;
                    }

                    .fleet-features {
                        margin-bottom: 1rem;
                    }

                    .fleet-price {
                        font-size: 1.1rem;
                        color: #2c3e50;
                    }

                    /* Gradient overlay for edges */
                    .fleet-marquee-container::before,
                    .fleet-marquee-container::after {
                        content: '';
                        position: absolute;
                        top: 0;
                        width: 100px;
                        height: 100%;
                        z-index: 2;
                        pointer-events: none;
                    }

                    .fleet-marquee-container::before {
                        left: 0;
                        background: linear-gradient(to right, rgba(248,249,250,1), rgba(248,249,250,0));
                    }

                    .fleet-marquee-container::after {
                        right: 0;
                        background: linear-gradient(to left, rgba(248,249,250,1), rgba(248,249,250,0));
                    }

                    /* Responsive adjustments */
                    @media (max-width: 768px) {
                        .fleet-card-marquee {
                            flex: 0 0 300px;
                        }

                        .fleet-marquee-wrapper {
                            animation: marquee 20s linear infinite;
                        }
                    }
                </style>

