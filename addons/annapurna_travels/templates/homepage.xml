                                    <h5 class="feature-title fw-bold">100% Safe</h5>
                                    <p class="feature-description">Well-maintained buses with safety checks</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 text-center">
                                <div class="feature-item">
                                    <div class="feature-icon mb-3">
                                        <i class="fas fa-clock fa-3x text-warning"></i>
                                    </div>
                                    <h5 class="feature-title fw-bold">On-Time Service</h5>
                                    <p class="feature-description">Punctual and reliable transportation</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 text-center">
                                <div class="feature-item">
                                    <div class="feature-icon mb-3">
                                        <i class="fas fa-headset fa-3x text-warning"></i>
                                    </div>
                                    <h5 class="feature-title fw-bold">24/7 Support</h5>
                                    <p class="feature-description">Round-the-clock customer assistance</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 text-center">
                                <div class="feature-item">
                                    <div class="feature-icon mb-3">
                                        <i class="fas fa-map-marked-alt fa-3x text-warning"></i>
                                    </div>
                                    <h5 class="feature-title fw-bold">GPS Tracking</h5>
                                    <p class="feature-description">Real-time bus location tracking</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Testimonials Section -->
                <section class="testimonials-section py-5" t-if="testimonials">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-6 mx-auto text-center mb-5">
                                <h2 class="section-title display-5 fw-bold mb-3">What Our Customers Say</h2>
                                <p class="section-subtitle text-muted">
                                    Real experiences from our satisfied customers
                                </p>
                            </div>
                        </div>
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        <t t-foreach="testimonials" t-as="testimonial">
                                            <div t-attf-class="carousel-item #{'active' if testimonial_first else ''}">
                                                <div class="testimonial-card bg-white rounded-4 p-5 shadow-sm text-center">
                                                    <div class="testimonial-stars mb-3">
                                                        <t t-foreach="range(int(testimonial.rating))" t-as="star">
                                                            <i class="fas fa-star text-warning"></i>
                                                        </t>
                                                    </div>
                                                    <blockquote class="testimonial-text h5 mb-4 text-muted fst-italic">
                                                        "<t t-esc="testimonial.testimonial"/>"
                                                    </blockquote>
                                                    <div class="testimonial-author">
                                                        <div class="author-avatar bg-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                            <span class="text-white fw-bold">
                                                                <t t-esc="testimonial.name[:2].upper()"/>
                                                            </span>
                                                        </div>
                                                        <h6 class="author-name fw-bold mb-1" t-field="testimonial.name"/>
                                                        <p class="author-designation text-muted small" t-field="testimonial.designation"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                    <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon"></span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
                                        <span class="carousel-control-next-icon"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Our Clients Section -->
                <t t-call="annapurna_travels.clients_section"/>

                <!-- CTA Section -->
                <section class="cta-section py-5 bg-gradient-primary text-white">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-8">
                                <h3 class="cta-title display-6 fw-bold mb-3">Ready to Start Your Journey?</h3>
                                <p class="cta-subtitle lead mb-0">
                                    Book your comfortable and safe travel experience with Annapurna Travels today.
                                </p>
                            </div>
                            <div class="col-lg-4 text-lg-end">
                                <a href="/booking" class="btn btn-light btn-lg rounded-pill px-5">
                                    <i class="fas fa-calendar-check me-2"></i>Book Now
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </template>
    </data>
</odoo>
