<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tours Page Template -->
        <template id="tours_page" name="Annapurna Travels - Tour Packages">
            <t t-call="website.layout">
                <t t-set="title">Tour Packages - Annapurna Travels</t>
                <t t-set="additional_title">Explore Amazing Destinations</t>

                <!-- Page Header -->
                <section class="page-header">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-8 mx-auto text-center">
                                <h1 class="page-title">Our Tour Packages</h1>
                                <p class="page-subtitle">
                                    Discover incredible destinations with our carefully crafted tour packages
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Tour Packages Grid -->
                <section class="tour-packages-section py-5">
                    <div class="container">
                        <div class="row g-4">
                            <t t-foreach="packages" t-as="package">
                                <div class="col-lg-4 col-md-6">
                                    <div class="tour-package-card h-100 bg-white rounded-4 shadow-sm overflow-hidden">
                                        <div class="package-image position-relative">
                                            <img t-if="package.image"
                                                 t-attf-src="data:image/png;base64,#{package.image}"
                                                 class="card-img-top"
                                                 style="height: 250px; object-fit: cover;"
                                                 t-att-alt="package.name"/>
                                            <div t-if="not package.image"
                                                 class="package-placeholder bg-light d-flex align-items-center justify-content-center"
                                                 style="height: 250px;">
                                                <i class="fas fa-mountain fa-3x text-muted"></i>
                                            </div>

                                            <!-- Duration Badge -->
                                            <div class="duration-badge position-absolute top-0 end-0 m-3">
                                                <span class="badge bg-primary">
                                                    <t t-esc="package.duration_days"/>D/<t t-esc="package.duration_nights"/>N
                                                </span>
                                            </div>
                                        </div>

                                        <div class="card-body p-4">
                                            <h5 class="card-title fw-bold mb-2">
                                                <t t-esc="package.name"/>
                                            </h5>

                                            <!-- Destinations -->
                                            <div class="destinations mb-3" t-if="package.destination_ids">
                                                <div class="d-flex align-items-center text-muted small">
                                                    <i class="fas fa-map-marker-alt me-2"></i>
                                                    <span>
                                                        <t t-foreach="package.destination_ids[:2]" t-as="dest">
                                                            <t t-esc="dest.name"/><t t-if="not dest_last">, </t>
                                                        </t>
                                                        <t t-if="len(package.destination_ids) > 2">
                                                            +<t t-esc="len(package.destination_ids) - 2"/> more
                                                        </t>
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Package Features -->
                                            <div class="package-features mb-3">
                                                <div class="row g-2 small text-muted">
                                                    <div class="col-6" t-if="package.includes_accommodation">
                                                        <i class="fas fa-bed me-1"></i> Accommodation
                                                    </div>
                                                    <div class="col-6" t-if="package.includes_meals">
                                                        <i class="fas fa-utensils me-1"></i> Meals
                                                    </div>
                                                    <div class="col-6" t-if="package.includes_transport">
                                                        <i class="fas fa-bus me-1"></i> Transport
                                                    </div>
                                                    <div class="col-6" t-if="package.includes_sightseeing">
                                                        <i class="fas fa-camera me-1"></i> Sightseeing
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Pricing -->
                                            <div class="pricing mb-3">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <span class="fw-bold text-primary fs-5">
                                                            ₹<t t-esc="'{:,.0f}'.format(package.price_per_person)"/>
                                                        </span>
                                                        <small class="text-muted">/person</small>
                                                    </div>
                                                    <div class="text-end small text-muted">
                                                        Min: <t t-esc="package.min_persons"/> persons
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Description Preview -->
                                            <div class="description-preview mb-3" t-if="package.website_description">
                                                <p class="small text-muted mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                                    <t t-raw="package.website_description[:150]"/>...
                                                </p>
                                            </div>

                                            <!-- Actions -->
                                            <div class="package-actions">
                                                <div class="row g-2">
                                                    <div class="col-8">
                                                        <a t-attf-href="/tour/#{package.id}"
                                                           class="btn btn-primary w-100 rounded-pill">
                                                            View Details
                                                        </a>
                                                    </div>
                                                    <div class="col-4">
                                                        <a href="/booking"
                                                           class="btn btn-outline-primary w-100 rounded-pill">
                                                            Book
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- No packages message -->
                        <div t-if="not packages" class="text-center py-5">
                            <i class="fas fa-map fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No tour packages available at the moment</h4>
                            <p class="text-muted">Please check back later for exciting tour packages!</p>
                        </div>
                    </div>
                </section>

                <!-- Popular Destinations Section -->
                <section class="popular-destinations py-5 bg-light">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-6 mx-auto text-center mb-5">
                                <h2 class="section-title display-6 fw-bold mb-3">Popular Destinations</h2>
                                <p class="section-subtitle text-muted">
                                    Explore the most sought-after travel destinations
                                </p>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-lg-3 col-md-6 text-center">
                                <div class="destination-item p-4">
                                    <div class="destination-icon mb-3">
                                        <i class="fas fa-mountain fa-3x text-primary"></i>
                                    </div>
                                    <h5 class="fw-bold mb-2">Himachal Pradesh</h5>
                                    <p class="text-muted small">Shimla, Manali, Dharamshala</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 text-center">
                                <div class="destination-item p-4">
                                    <div class="destination-icon mb-3">
                                        <i class="fas fa-umbrella-beach fa-3x text-primary"></i>
                                    </div>
                                    <h5 class="fw-bold mb-2">Goa</h5>
                                    <p class="text-muted small">Beaches, Nightlife, Heritage</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 text-center">
                                <div class="destination-item p-4">
                                    <div class="destination-icon mb-3">
                                        <i class="fas fa-fort-awesome fa-3x text-primary"></i>
                                    </div>
                                    <h5 class="fw-bold mb-2">Rajasthan</h5>
                                    <p class="text-muted small">Jaipur, Udaipur, Jodhpur</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 text-center">
                                <div class="destination-item p-4">
                                    <div class="destination-icon mb-3">
                                        <i class="fas fa-om fa-3x text-primary"></i>
                                    </div>
                                    <h5 class="fw-bold mb-2">Spiritual Tours</h5>
                                    <p class="text-muted small">Temples, Pilgrimage Sites</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Tour Features Section -->
                <section class="tour-features py-5">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6">
                                <h2 class="display-6 fw-bold mb-4">Why Choose Our Tours?</h2>
                                <p class="lead mb-4">
                                    We ensure every aspect of your journey is carefully planned and executed for maximum comfort and enjoyment.
                                </p>

                                <div class="features-list">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="feature-item d-flex align-items-center">
                                                <i class="fas fa-check-circle text-success me-3"></i>
                                                <span>Expert Tour Guides</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="feature-item d-flex align-items-center">
                                                <i class="fas fa-check-circle text-success me-3"></i>
                                                <span>Comfortable AC Buses</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="feature-item d-flex align-items-center">
                                                <i class="fas fa-check-circle text-success me-3"></i>
                                                <span>Quality Accommodations</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="feature-item d-flex align-items-center">
                                                <i class="fas fa-check-circle text-success me-3"></i>
                                                <span>All Meals Included</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="feature-item d-flex align-items-center">
                                                <i class="fas fa-check-circle text-success me-3"></i>
                                                <span>24/7 Support</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="feature-item d-flex align-items-center">
                                                <i class="fas fa-check-circle text-success me-3"></i>
                                                <span>Customizable Itineraries</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="tour-features-image text-center">
                                    <div class="image-placeholder bg-light rounded-4 p-5">
                                        <i class="fas fa-route fa-5x text-primary opacity-50"></i>
                                        <p class="text-muted mt-3">Tour Experience</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CTA Section -->
                <section class="cta-section py-5 bg-gradient-primary text-white">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-8">
                                <h3 class="display-6 fw-bold mb-3">Ready for Your Next Adventure?</h3>
                                <p class="lead mb-0">
                                    Book your dream tour package now and create memories that last a lifetime.
                                </p>
                            </div>
                            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                                <div class="cta-buttons">
                                    <a href="/booking" class="btn btn-light btn-lg rounded-pill px-4 me-3">
                                        <i class="fas fa-calendar-check me-2"></i>Book Tour
                                    </a>
                                    <a href="/contact" class="btn btn-outline-light btn-lg rounded-pill px-4">
                                        <i class="fas fa-phone me-2"></i>Contact Us
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            </t>
        </template>

        <!-- Tour Detail Page Template -->
        <template id="tour_detail_page" name="Annapurna Travels - Tour Detail">
            <t t-call="website.layout">
                <t t-set="title"><t t-esc="package.name"/> - Annapurna Travels</t>

                <!-- Tour Detail Header -->
                <section class="tour-detail-header py-5">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-8">
                                <nav aria-label="breadcrumb" class="mb-4">
                                    <ol class="breadcrumb">
                                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                                        <li class="breadcrumb-item"><a href="/tours">Tours</a></li>
                                        <li class="breadcrumb-item active" aria-current="page"><t t-esc="package.name"/></li>
                                    </ol>
                                </nav>

                                <h1 class="display-5 fw-bold mb-3"><t t-esc="package.name"/></h1>

                                <div class="tour-meta d-flex flex-wrap gap-4 mb-4">
                                    <div class="meta-item">
                                        <i class="fas fa-calendar-alt text-primary me-2"></i>
                                        <strong><t t-esc="package.duration_days"/> Days / <t t-esc="package.duration_nights"/> Nights</strong>
                                    </div>
                                    <div class="meta-item" t-if="package.destination_ids">
                                        <i class="fas fa-map-marker-alt text-primary me-2"></i>
                                        <t t-foreach="package.destination_ids" t-as="dest">
                                            <t t-esc="dest.name"/><t t-if="not dest_last">, </t>
                                        </t>
                                    </div>
                                    <div class="meta-item">
                                        <i class="fas fa-users text-primary me-2"></i>
                                        <t t-esc="package.min_persons"/> - <t t-esc="package.max_persons"/> persons
                                    </div>
                                </div>

                                <!-- Package Features -->
                                <div class="package-inclusions">
                                    <h6 class="fw-bold mb-3">Package Includes:</h6>
                                    <div class="row g-3">
                                        <div class="col-auto" t-if="package.includes_accommodation">
                                            <span class="badge bg-success">
                                                <i class="fas fa-bed me-1"></i> Accommodation
                                            </span>
                                        </div>
                                        <div class="col-auto" t-if="package.includes_meals">
                                            <span class="badge bg-success">
                                                <i class="fas fa-utensils me-1"></i> Meals
                                            </span>
                                        </div>
                                        <div class="col-auto" t-if="package.includes_transport">
                                            <span class="badge bg-success">
                                                <i class="fas fa-bus me-1"></i> Transport
                                            </span>
                                        </div>
                                        <div class="col-auto" t-if="package.includes_sightseeing">
                                            <span class="badge bg-success">
                                                <i class="fas fa-camera me-1"></i> Sightseeing
                                            </span>
                                        </div>
                                        <div class="col-auto" t-if="package.includes_guide">
                                            <span class="badge bg-success">
                                                <i class="fas fa-user-tie me-1"></i> Guide
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <!-- Booking Card -->
                                <div class="booking-card bg-white rounded-4 shadow p-4 sticky-top" style="top: 100px;">
                                    <div class="pricing text-center mb-4">
                                        <div class="price-main">
                                            <span class="display-6 fw-bold text-primary">
                                                ₹<t t-esc="'{:,.0f}'.format(package.price_per_person)"/>
                                            </span>
                                            <small class="text-muted">/person</small>
                                        </div>
                                        <div class="price-child" t-if="package.child_price > 0">
                                            <small class="text-muted">
                                                Child: ₹<t t-esc="'{:,.0f}'.format(package.child_price)"/>
                                            </small>
                                        </div>
                                    </div>

                                    <div class="booking-actions">
                                        <a href="/booking" class="btn btn-primary w-100 btn-lg rounded-pill mb-3">
                                            <i class="fas fa-calendar-check me-2"></i>Book This Tour
                                        </a>
                                        <a href="/contact" class="btn btn-outline-primary w-100 rounded-pill">
                                            <i class="fas fa-phone me-2"></i>Get Custom Quote
                                        </a>
                                    </div>

                                    <hr class="my-4"/>

                                    <div class="contact-info text-center">
                                        <h6 class="fw-bold mb-3">Need Help?</h6>
                                        <p class="small text-muted mb-2">
                                            <i class="fas fa-phone me-2"></i>+91 XXX-XXX-XXXX
                                        </p>
                                        <p class="small text-muted">
                                            <i class="fas fa-envelope me-2"></i>info@annapurnatravels.co.in
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Tour Content -->
                <section class="tour-content py-5">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-8">
                                <!-- Package Image -->
                                <div class="tour-image mb-5" t-if="package.image">
                                    <img t-attf-src="data:image/png;base64,#{package.image}"
                                         class="img-fluid rounded-4 w-100"
                                         style="max-height: 400px; object-fit: cover;"
                                         t-att-alt="package.name"/>
                                </div>

                                <!-- Package Description -->
                                <div class="tour-description mb-5" t-if="package.description">
                                    <h3 class="fw-bold mb-4">About This Tour</h3>
                                    <div class="content-section">
                                        <t t-raw="package.description"/>
                                    </div>
                                </div>

                                <!-- Itinerary -->
                                <div class="tour-itinerary mb-5" t-if="package.itinerary">
                                    <h3 class="fw-bold mb-4">Detailed Itinerary</h3>
                                    <div class="content-section">
                                        <t t-raw="package.itinerary"/>
                                    </div>
                                </div>

                                <!-- Inclusions -->
                                <div class="tour-inclusions mb-5" t-if="package.inclusions">
                                    <h3 class="fw-bold mb-4">What's Included</h3>
                                    <div class="content-section">
                                        <t t-raw="package.inclusions"/>
                                    </div>
                                </div>

                                <!-- Exclusions -->
                                <div class="tour-exclusions mb-5" t-if="package.exclusions">
                                    <h3 class="fw-bold mb-4">What's Not Included</h3>
                                    <div class="content-section">
                                        <t t-raw="package.exclusions"/>
                                    </div>
                                </div>

                                <!-- Terms & Conditions -->
                                <div class="tour-terms mb-5" t-if="package.terms_conditions">
                                    <h3 class="fw-bold mb-4">Terms &amp; Conditions</h3>
                                    <div class="content-section">
                                        <t t-raw="package.terms_conditions"/>
                                    </div>
                                </div>

                                <!-- Gallery -->
                                <div class="tour-gallery mb-5" t-if="package.images">
                                    <h3 class="fw-bold mb-4">Photo Gallery</h3>
                                    <div class="row g-3">
                                        <t t-foreach="package.images" t-as="img">
                                            <div class="col-lg-4 col-md-6">
                                                <img t-attf-src="data:image/png;base64,#{img.image}"
                                                     class="img-fluid rounded-3 w-100"
                                                     style="height: 200px; object-fit: cover;"
                                                     t-att-alt="img.name or package.name"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <!-- Empty space for sidebar content if needed -->
                            </div>
                        </div>
                    </div>
                </section>

            </t>
        </template>

    </data>
</odoo>