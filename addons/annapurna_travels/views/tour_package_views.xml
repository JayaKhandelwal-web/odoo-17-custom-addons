<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tour Package Tree View -->
        <record id="view_tour_package_tree" model="ir.ui.view">
            <field name="name">tour.package.tree</field>
            <field name="model">tour.package</field>
            <field name="arch" type="xml">
                <tree string="Tour Packages" decoration-success="state=='active'"
                      decoration-warning="state=='draft'" decoration-muted="state=='inactive'">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="duration_days"/>
                    <field name="duration_nights"/>
                    <field name="price_per_person"/>
                    <field name="min_persons"/>
                    <field name="max_persons"/>
                    <field name="website_published"/>
                    <field name="booking_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Tour Package Form View -->
        <record id="view_tour_package_form" model="ir.ui.view">
            <field name="name">tour.package.form</field>
            <field name="model">tour.package</field>
            <field name="arch" type="xml">
                <form string="Tour Package">
                    <header>
                        <button name="action_activate" type="object" string="Activate"
                                invisible="state == 'active'"
                                class="btn-primary"/>
                        <button name="action_suspend" type="object" string="Suspend"
                                invisible="state != 'active'"
                                class="btn-warning"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,active,suspended"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-calendar">
                                <field name="booking_count" widget="statinfo" string="Bookings"/>
                            </button>
                        </div>

                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Package Name"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Basic Information">
                                <field name="code"/>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                            <group string="Duration">
                                <field name="duration_days"/>
                                <field name="duration_nights"/>
                            </group>
                        </group>

                        <group>
                            <group string="Destinations">
                                <field name="destination_ids" widget="many2many_tags"/>
                            </group>
                            <group string="Availability">
                                <field name="available_from"/>
                                <field name="available_to"/>
                            </group>
                        </group>

                        <group>
                            <group string="Pricing">
                                <field name="price_per_person"/>
                                <field name="child_price"/>
                                <field name="min_persons"/>
                                <field name="max_persons"/>
                            </group>
                            <group string="Package Inclusions">
                                <field name="includes_accommodation"/>
                                <field name="includes_meals"/>
                                <field name="includes_transport"/>
                                <field name="includes_sightseeing"/>
                                <field name="includes_guide"/>
                            </group>
                        </group>

                        <group>
                            <group string="Website Settings">
                                <field name="website_published"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Description">
                                <field name="description" widget="html"/>
                            </page>
                            <page string="Itinerary">
                                <field name="itinerary" widget="html"/>
                            </page>
                            <page string="Inclusions">
                                <field name="inclusions" widget="html"/>
                            </page>
                            <page string="Exclusions">
                                <field name="exclusions" widget="html"/>
                            </page>
                            <page string="Terms &amp; Conditions">
                                <field name="terms_conditions" widget="html"/>
                            </page>
                            <page string="Website Description">
                                <field name="website_description" widget="html"/>
                            </page>
                            <page string="Gallery">
                                <field name="images">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="image" widget="image"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tour Package Kanban View -->
        <record id="view_tour_package_kanban" model="ir.ui.view">
            <field name="name">tour.package.kanban</field>
            <field name="model">tour.package</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="name"/>
                    <field name="duration_days"/>
                    <field name="duration_nights"/>
                    <field name="price_per_person"/>
                    <field name="booking_count"/>
                    <field name="website_published"/>
                    <field name="state"/>
                    <field name="image"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('tour.package', 'image', record.id.raw_value)" alt="Package"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_body">
                                        <t t-esc="record.duration_days.value"/>D/<t t-esc="record.duration_nights.value"/>N
                                        <br/>
                                        Price: ₹<field name="price_per_person"/> per person
                                        <br/>
                                        Bookings: <field name="booking_count"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-if="record.website_published.raw_value" class="badge badge-success">Published</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Tour Package Action -->
        <record id="action_tour_package" model="ir.actions.act_window">
            <field name="name">Tour Packages</field>
            <field name="res_model">tour.package</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first tour package!
                </p>
                <p>
                    Design attractive tour packages with destinations, pricing, and detailed itineraries.
                </p>
            </field>
        </record>

        <!-- Tour Destination Views -->
        <record id="view_tour_destination_tree" model="ir.ui.view">
            <field name="name">tour.destination.tree</field>
            <field name="model">tour.destination</field>
            <field name="arch" type="xml">
                <tree string="Tour Destinations">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="state_id"/>
                    <field name="country_id"/>
                    <field name="best_time_to_visit"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_tour_destination_form" model="ir.ui.view">
            <field name="name">tour.destination.form</field>
            <field name="model">tour.destination</field>
            <field name="arch" type="xml">
                <form string="Tour Destination">
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Destination Name"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Basic Information">
                                <field name="code"/>
                                <field name="state_id"/>
                                <field name="country_id"/>
                                <field name="active"/>
                            </group>
                            <group string="Location">
                                <field name="latitude"/>
                                <field name="longitude"/>
                            </group>
                        </group>

                        <group>
                            <group string="Tourist Information">
                                <field name="best_time_to_visit"/>
                                <field name="local_language"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Description">
                                <field name="description" placeholder="Describe this destination..."/>
                            </page>
                            <page string="Weather Information">
                                <field name="weather_info" placeholder="Weather information for tourists..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_tour_destination" model="ir.actions.act_window">
            <field name="name">Tour Destinations</field>
            <field name="res_model">tour.destination</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add your first destination!
                </p>
                <p>
                    Create a database of tourist destinations with detailed information for your tour packages.
                </p>
            </field>
        </record>

    </data>
</odoo>