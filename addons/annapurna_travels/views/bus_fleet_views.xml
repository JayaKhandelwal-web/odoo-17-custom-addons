<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Bus Category Views -->
        <record id="view_bus_category_tree" model="ir.ui.view">
            <field name="name">bus.category.tree</field>
            <field name="model">bus.category</field>
            <field name="arch" type="xml">
                <tree string="Bus Categories">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_bus_category_form" model="ir.ui.view">
            <field name="name">bus.category.form</field>
            <field name="model">bus.category</field>
            <field name="arch" type="xml">
                <form string="Bus Category">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Category Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" placeholder="Describe this bus category..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_bus_category" model="ir.actions.act_window">
            <field name="name">Bus Categories</field>
            <field name="res_model">bus.category</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first bus category!
                </p>
                <p>
                    Define different categories of buses in your fleet like Luxury AC Coaches, Mini Buses, etc.
                </p>
            </field>
        </record>

        <!-- Bus Fleet Views -->
        <record id="view_bus_fleet_tree" model="ir.ui.view">
            <field name="name">bus.fleet.tree</field>
            <field name="model">bus.fleet</field>
            <field name="arch" type="xml">
                <tree string="Bus Fleet" decoration-success="state=='available'"
                      decoration-warning="state=='maintenance'" decoration-danger="state=='inactive'">
                    <field name="name"/>
                    <field name="vehicle_number"/>
                    <field name="category_id"/>
                    <field name="seating_capacity"/>
                    <field name="daily_rate"/>
                    <field name="state"/>
                    <field name="booking_count"/>
                    <field name="has_video" string="Video" widget="boolean"/>
                </tree>
            </field>
        </record>

        <record id="view_bus_fleet_form" model="ir.ui.view">
            <field name="name">bus.fleet.form</field>
            <field name="model">bus.fleet</field>
            <field name="arch" type="xml">
                <form string="Bus Fleet">
                    <header>
                        <button name="action_set_available" type="object" string="Set Available"
                                invisible="state == 'available'"
                                class="btn-primary"/>
                        <button name="action_set_maintenance" type="object" string="Set Maintenance"
                                invisible="state == 'maintenance'"
                                class="btn-warning"/>
                        <field name="state" widget="statusbar" statusbar_visible="available,booked,maintenance"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-calendar">
                                <field name="booking_count" widget="statinfo" string="Bookings"/>
                            </button>
                        </div>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Bus Name/Number"/>
                            </h1>
                            <h2>
                                <field name="vehicle_number" placeholder="Vehicle Number"/>
                            </h2>
                        </div>
                        <group>
                            <group string="Basic Information">
                                <field name="category_id"/>
                                <field name="seating_capacity"/>
                                <field name="manufacture_year"/>
                                <field name="active"/>
                            </group>
                            <group string="Pricing">
                                <field name="daily_rate"/>
                                <field name="per_km_rate"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Video &amp; Media">
                                <group>
                                    <group string="MP4 Video Upload (Priority)" class="col-12">
                                        <div class="alert alert-info mb-3" role="alert">
                                            <i class="fa fa-info-circle"/>
                                            <strong>Upload MP4 Video:</strong> The uploaded MP4 video will be displayed FIRST on the website before images.
                                            Maximum recommended size: 50MB for optimal performance.
                                        </div>
                                        <field name="video_file" filename="video_filename"
                                               widget="binary"
                                               class="oe_inline"/>
                                        <field name="video_filename" invisible="1"/>
                                        <field name="has_video" invisible="1"/>
                                        <div class="alert alert-success mt-2" role="alert"
                                             invisible="not video_file">
                                            <i class="fa fa-check-circle"/>
                                            <strong>Success!</strong> MP4 video uploaded. This will be displayed first on the website.
                                        </div>
                                    </group>
                                </group>
                                <group>
                                    <group string="YouTube Video (Alternative)">
                                        <div class="alert alert-warning mb-2" role="alert">
                                            <i class="fa fa-youtube-play"/>
                                            YouTube URL will only be used if no MP4 video is uploaded.
                                        </div>
                                        <field name="youtube_video_url" widget="url"
                                               placeholder="https://www.youtube.com/watch?v=xxxxx"/>
                                        <field name="video_thumbnail" widget="image" readonly="1"
                                               invisible="not youtube_video_url"/>
                                    </group>
                                    <group string="Price Range &amp; Ratings">
                                        <field name="price_range_min"/>
                                        <field name="price_range_max"/>
                                        <field name="average_rating" readonly="1" widget="float"/>
                                        <field name="review_count" readonly="1"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Features &amp; Amenities">
                                <group>
                                    <group string="Basic Features">
                                        <field name="is_ac"/>
                                        <field name="has_wifi"/>
                                        <field name="has_music_system"/>
                                        <field name="has_tv"/>
                                    </group>
                                    <group string="Comfort Features">
                                        <field name="has_charging_point"/>
                                        <field name="has_washroom"/>
                                        <field name="pushback_seats"/>
                                        <field name="reading_lights"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Staff &amp; Documents">
                                <group>
                                    <group string="Staff">
                                        <field name="driver_id"/>
                                        <field name="conductor_id"/>
                                    </group>
                                    <group string="Documents &amp; Permits">
                                        <field name="insurance_expiry"/>
                                        <field name="permit_expiry"/>
                                        <field name="fitness_expiry"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Description">
                                <field name="description" placeholder="Describe this bus..."/>
                            </page>

                            <page string="Additional Images">
                                <field name="images">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="image" widget="image"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Technical Specifications">
                                <group>
                                    <group string="Engine &amp; Performance">
                                        <field name="engine_type"/>
                                        <field name="power_output"/>
                                        <field name="transmission"/>
                                        <field name="fuel_capacity"/>
                                        <field name="mileage"/>
                                    </group>
                                    <group string="Dimensions">
                                        <field name="overall_length"/>
                                        <field name="overall_width"/>
                                        <field name="overall_height"/>
                                        <field name="ground_clearance"/>
                                        <field name="suspension_type"/>
                                        <field name="braking_system"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Advanced Comfort">
                                <group>
                                    <group string="Climate Control">
                                        <field name="multi_zone_ac"/>
                                        <field name="air_purification"/>
                                        <field name="humidity_control"/>
                                    </group>
                                    <group string="Seating Comfort">
                                        <field name="ergonomic_seats"/>
                                        <field name="adjustable_headrests"/>
                                        <field name="seat_belts"/>
                                        <field name="extra_legroom"/>
                                    </group>
                                    <group string="Lighting System">
                                        <field name="led_ambient_lighting"/>
                                        <field name="individual_reading_lights"/>
                                        <field name="step_lighting"/>
                                        <field name="emergency_lighting"/>
                                        <field name="mood_lighting"/>
                                    </group>
                                    <group string="Refreshment">
                                        <field name="mini_refrigerator"/>
                                        <field name="refrigerator_capacity" invisible="not mini_refrigerator"/>
                                        <field name="water_dispenser"/>
                                        <field name="cup_holders"/>
                                        <field name="waste_disposal"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Entertainment System">
                                <group>
                                    <group string="Audio Visual">
                                        <field name="led_tv_screens"/>
                                        <field name="tv_screen_size" invisible="not led_tv_screens"/>
                                        <field name="dvd_player"/>
                                        <field name="surround_sound"/>
                                        <field name="wireless_microphone"/>
                                        <field name="bluetooth_connectivity"/>
                                    </group>
                                    <group string="Charging &amp; Power">
                                        <field name="usb_charging_ports"/>
                                        <field name="power_outlets_230v"/>
                                        <field name="mobile_holders"/>
                                        <field name="wireless_charging"/>
                                        <field name="power_backup"/>
                                    </group>
                                    <group string="Connectivity">
                                        <field name="wifi_hotspot"/>
                                        <field name="gps_navigation"/>
                                        <field name="real_time_tracking"/>
                                        <field name="digital_display"/>
                                        <field name="pa_system"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Safety &amp; Security">
                                <group>
                                    <group string="Safety Systems">
                                        <field name="abs_ebd"/>
                                        <field name="speed_limiting"/>
                                        <field name="driver_fatigue_monitor"/>
                                        <field name="hill_start_assist"/>
                                        <field name="emergency_braking"/>
                                    </group>
                                    <group string="Emergency Equipment">
                                        <field name="fire_extinguisher"/>
                                        <field name="first_aid_kit"/>
                                        <field name="emergency_exits"/>
                                        <field name="emergency_hammer"/>
                                        <field name="warning_triangles"/>
                                    </group>
                                    <group string="Security Features">
                                        <field name="cctv_surveillance"/>
                                        <field name="gps_tracking_security"/>
                                        <field name="anti_theft_alarm"/>
                                        <field name="central_locking"/>
                                        <field name="panic_button"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_bus_fleet_kanban" model="ir.ui.view">
            <field name="name">bus.fleet.kanban</field>
            <field name="model">bus.fleet</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="vehicle_number"/>
                    <field name="category_id"/>
                    <field name="seating_capacity"/>
                    <field name="state"/>
                    <field name="daily_rate"/>
                    <field name="image"/>
                    <field name="has_video"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('bus.fleet', 'image', record.id.raw_value)" alt="Bus"/>
                                    <div t-if="record.has_video.raw_value" class="ribbon ribbon-top-right">
                                        <span class="bg-danger">
                                            <i class="fa fa-video-camera"/> Video
                                        </span>
                                    </div>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="vehicle_number"/>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="category_id"/>
                                        <br/>
                                        Capacity: <field name="seating_capacity"/> seats
                                        <br/>
                                        Rate: ₹<field name="daily_rate" widget="float"/>/day
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-attf-class="badge badge-pill #{record.state.raw_value === 'available' ? 'badge-success' : record.state.raw_value === 'maintenance' ? 'badge-warning' : 'badge-secondary'}">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_bus_fleet_search" model="ir.ui.view">
            <field name="name">bus.fleet.search</field>
            <field name="model">bus.fleet</field>
            <field name="arch" type="xml">
                <search string="Search Bus Fleet">
                    <field name="name"/>
                    <field name="vehicle_number"/>
                    <field name="category_id"/>
                    <separator/>
                    <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                    <filter string="Booked" name="booked" domain="[('state', '=', 'booked')]"/>
                    <filter string="Maintenance" name="maintenance" domain="[('state', '=', 'maintenance')]"/>
                    <separator/>
                    <filter string="AC Buses" name="ac_buses" domain="[('is_ac', '=', True)]"/>
                    <filter string="With WiFi" name="wifi_buses" domain="[('has_wifi', '=', True)]"/>
                    <filter string="With Video" name="video_buses" domain="[('has_video', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_bus_fleet" model="ir.actions.act_window">
            <field name="name">Bus Fleet</field>
            <field name="res_model">bus.fleet</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_bus_fleet_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add your first bus to the fleet!
                </p>
                <p>
                    Manage your bus fleet including vehicle details, features, pricing, and availability.
                    Upload MP4 videos to showcase your buses on the website!
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_bus_fleet_root" name="Bus Fleet" sequence="10"/>
        <menuitem id="menu_bus_fleet" name="Fleet Management" parent="menu_bus_fleet_root" sequence="10"/>
        <menuitem id="menu_bus_fleet_buses" name="Buses" parent="menu_bus_fleet" action="action_bus_fleet" sequence="10"/>
        <menuitem id="menu_bus_categories" name="Categories" parent="menu_bus_fleet" action="action_bus_category" sequence="20"/>

    </data>
</odoo>