<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Bus Booking Tree View -->
        <record id="view_bus_booking_tree" model="ir.ui.view">
            <field name="name">bus.booking.tree</field>
            <field name="model">bus.booking</field>
            <field name="arch" type="xml">
                <tree string="Bus Bookings" decoration-success="state=='confirmed'"
                      decoration-warning="state=='draft'" decoration-info="state=='in_progress'"
                      decoration-muted="state=='cancelled'">
                    <field name="name"/>
                    <field name="booking_date"/>
                    <field name="customer_name"/>
                    <field name="customer_phone"/>
                    <field name="service_type_id"/>
                    <field name="bus_id"/>
                    <field name="pickup_date"/>
                    <field name="pickup_location"/>
                    <field name="passenger_count"/>
                    <field name="total_amount"/>
                    <field name="state"/>
                    <field name="is_website_booking"/>
                </tree>
            </field>
        </record>

        <!-- Bus Booking Form View -->
        <record id="view_bus_booking_form" model="ir.ui.view">
            <field name="name">bus.booking.form</field>
            <field name="model">bus.booking</field>
            <field name="arch" type="xml">
                <form string="Bus Booking">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm Booking"
                                invisible="state != 'draft'"
                                class="btn-primary"/>
                        <button name="action_start_journey" type="object" string="Start Journey"
                                invisible="state != 'confirmed'"
                                class="btn-success"/>
                        <button name="action_complete" type="object" string="Complete Journey"
                                invisible="state != 'in_progress'"
                                class="btn-info"/>
                        <button name="action_cancel" type="object" string="Cancel Booking"
                                invisible="state in ['completed', 'cancelled']"
                                class="btn-danger"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-globe" invisible="is_website_booking == False">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Website</span>
                                    <span class="o_stat_text">Booking</span>
                                </div>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Customer Information">
                                <field name="customer_id"/>
                                <field name="customer_name"/>
                                <field name="customer_phone"/>
                                <field name="customer_email"/>
                            </group>
                            <group string="Booking Information">
                                <field name="booking_date"/>
                                <field name="service_type_id"/>
                                <field name="bus_id"/>
                                <field name="is_website_booking" readonly="1"/>
                            </group>
                        </group>

                        <group>
                            <group string="Journey Details">
                                <field name="pickup_location"/>
                                <field name="drop_location"/>
                                <field name="pickup_date"/>
                                <field name="return_date"/>
                                <field name="is_round_trip"/>
                                <field name="distance_km"/>
                                <field name="duration_days"/>
                            </group>
                            <group string="Passengers">
                                <field name="passenger_count"/>
                                <field name="passenger_details"/>
                                <field name="special_requirements"/>
                            </group>
                        </group>

                        <group>
                            <group string="Pricing">
                                <field name="base_amount"/>
                                <field name="km_amount"/>
                                <field name="day_amount"/>
                                <field name="extra_charges"/>
                                <field name="discount"/>
                                <field name="tax_amount"/>
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                            <group string="Payment">
                                <field name="advance_amount"/>
                                <field name="balance_amount"/>
                            </group>
                        </group>

                        <group>
                            <field name="customer_address" placeholder="Customer Address"/>
                        </group>

                        <notebook>
                            <page string="Notes">
                                <group>
                                    <field name="notes" nolabel="1" placeholder="Internal notes..."/>
                                </group>
                            </page>
                            <page string="Driver Notes">
                                <group>
                                    <field name="driver_notes" nolabel="1" placeholder="Special instructions for driver..."/>
                                </group>
                            </page>
                            <page string="Cancellation" invisible="state != 'cancelled'">
                                <group>
                                    <field name="cancellation_reason" nolabel="1" placeholder="Reason for cancellation..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Bus Booking Kanban View -->
        <record id="view_bus_booking_kanban" model="ir.ui.view">
            <field name="name">bus.booking.kanban</field>
            <field name="model">bus.booking</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="name"/>
                    <field name="customer_name"/>
                    <field name="pickup_date"/>
                    <field name="pickup_location"/>
                    <field name="total_amount"/>
                    <field name="state"/>
                    <field name="is_website_booking"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="oe_kanban_details">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="customer_name"/>
                                        </div>
                                        <div class="o_kanban_record_body">
                                            <field name="pickup_location"/>
                                            <br/>
                                            <t t-esc="record.pickup_date.value"/>
                                            <br/>
                                            Amount: ₹<field name="total_amount"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span t-if="record.is_website_booking.raw_value" class="badge badge-info">Website</span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Bus Booking Search View -->
        <record id="view_bus_booking_search" model="ir.ui.view">
            <field name="name">bus.booking.search</field>
            <field name="model">bus.booking</field>
            <field name="arch" type="xml">
                <search string="Search Bookings">
                    <field name="name"/>
                    <field name="customer_name"/>
                    <field name="customer_phone"/>
                    <field name="pickup_location"/>
                    <field name="service_type_id"/>
                    <field name="bus_id"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <separator/>
                    <filter string="Website Bookings" name="website_bookings" domain="[('is_website_booking', '=', True)]"/>
                    <filter string="Today's Bookings" name="today" domain="[('booking_date', '>=', datetime.datetime.now().replace(hour=0, minute=0, second=0)), ('booking_date', '&lt;', datetime.datetime.now().replace(hour=23, minute=59, second=59))]"/>
                    <separator/>
                    <filter string="Booking Date" name="filter_booking_date" date="booking_date"/>
                    <filter string="Pickup Date" name="filter_pickup_date" date="pickup_date"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                        <filter string="Service Type" name="group_service" context="{'group_by': 'service_type_id'}"/>
                        <filter string="Bus" name="group_bus" context="{'group_by': 'bus_id'}"/>
                        <filter string="Booking Date" name="group_booking_date" context="{'group_by': 'booking_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Bus Booking Action -->
        <record id="action_bus_booking" model="ir.actions.act_window">
            <field name="name">Bus Bookings</field>
            <field name="res_model">bus.booking</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_bus_booking_search"/>
            <field name="context">{'search_default_confirmed': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first bus booking!
                </p>
                <p>
                    Manage bus bookings from customers including journey details, pricing, and status tracking.
                </p>
            </field>
        </record>

        <!-- Tour Booking Views -->
        <record id="view_tour_booking_tree" model="ir.ui.view">
            <field name="name">tour.booking.tree</field>
            <field name="model">tour.booking</field>
            <field name="arch" type="xml">
                <tree string="Tour Bookings" decoration-success="state=='confirmed'"
                      decoration-warning="state=='draft'" decoration-info="state=='in_progress'">
                    <field name="name"/>
                    <field name="customer_name"/>
                    <field name="customer_phone"/>
                    <field name="package_id"/>
                    <field name="travel_date"/>
                    <field name="adults"/>
                    <field name="children"/>
                    <field name="total_amount"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_tour_booking_form" model="ir.ui.view">
            <field name="name">tour.booking.form</field>
            <field name="model">tour.booking</field>
            <field name="arch" type="xml">
                <form string="Tour Booking">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm Booking"
                                invisible="state != 'draft'"
                                class="btn-primary"/>
                        <button name="action_start_tour" type="object" string="Start Tour"
                                invisible="state != 'confirmed'"
                                class="btn-success"/>
                        <button name="action_complete" type="object" string="Complete Tour"
                                invisible="state != 'in_progress'"
                                class="btn-info"/>
                        <button name="action_cancel" type="object" string="Cancel Booking"
                                invisible="state in ['completed', 'cancelled']"
                                class="btn-danger"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Customer Information">
                                <field name="customer_id"/>
                                <field name="customer_name"/>
                                <field name="customer_phone"/>
                                <field name="customer_email"/>
                            </group>
                            <group string="Tour Details">
                                <field name="package_id"/>
                                <field name="travel_date"/>
                                <field name="return_date"/>
                                <field name="booking_date"/>
                            </group>
                        </group>

                        <group>
                            <group string="Travelers">
                                <field name="adults"/>
                                <field name="children"/>
                                <field name="total_persons"/>
                            </group>
                            <group string="Pricing">
                                <field name="adult_price"/>
                                <field name="child_price"/>
                                <field name="subtotal"/>
                                <field name="discount"/>
                                <field name="tax_amount"/>
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                                <field name="advance_amount"/>
                                <field name="balance_amount"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Special Requirements">
                                <field name="special_requirements" nolabel="1" placeholder="Any special requirements or requests..."/>
                            </page>
                            <page string="Notes">
                                <field name="notes" nolabel="1" placeholder="Internal notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_tour_booking" model="ir.actions.act_window">
            <field name="name">Tour Bookings</field>
            <field name="res_model">tour.booking</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first tour booking!
                </p>
                <p>
                    Manage tour package bookings with customer details, travel dates, and pricing.
                </p>
            </field>
        </record>

    </data>
</odoo>