#!/bin/bash

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}🔄 Syncing Repository & Updating Odoo...${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# Step 1: Pull latest code from GitHub
echo -e "${BLUE}📥 Step 1: Pulling latest code from GitHub...${NC}"
git checkout main
git pull origin main

if [ $? -ne 0 ]; then
    echo -e "${RED}❌ Failed to pull from GitHub${NC}"
    exit 1
fi

# Step 2: Show what changed
echo ""
echo -e "${YELLOW}📊 Recent Changes:${NC}"
git log --oneline --graph --all -5
echo ""

# Step 3: Restart Odoo Docker container
echo -e "${BLUE}🔄 Step 2: Restarting Odoo Docker container...${NC}"
cd ~/odoo17-docker
docker-compose restart

if [ $? -ne 0 ]; then
    echo -e "${RED}❌ Failed to restart Docker${NC}"
    exit 1
fi

echo -e "${GREEN}✅ Docker restarted successfully${NC}"

# Step 4: Wait for Odoo to be ready
echo -e "${BLUE}⏳ Waiting for Odoo to start (30 seconds)...${NC}"
sleep 30

# Step 5: Instructions for module update
echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ Code sync & Docker restart complete!${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "${YELLOW}📝 NEXT STEPS - Update Odoo Database:${NC}"
echo ""
echo -e "  1. Go to: ${BLUE}http://localhost:8069${NC}"
echo -e "  2. Login to Odoo"
echo -e "  3. Go to: ${BLUE}Apps${NC}"
echo -e "  4. Remove 'Apps' filter to show all modules"
echo -e "  5. Search for updated modules"
echo -e "  6. Click ${BLUE}'Upgrade'${NC} on changed modules"
echo ""
echo -e "${YELLOW}OR use the module update script:${NC}"
echo -e "  ${BLUE}./scripts/update-modules.sh module_name1 module_name2${NC}"
echo ""

# Return to addons directory
cd ~/odoo17-docker/addons
