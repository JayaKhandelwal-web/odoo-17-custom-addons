<!--  ④  MANAGER — 1-DAY FINAL ALERT                                        -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<record id="email_template_fleet_booking_manager_1day" model="mail.template">
    <field name="name">Fleet Booking: Manager 1-Day Final Alert (Internal)</field>
    <field name="model_id" ref="fleet_booking.model_fleet_booking"/>
    <field name="subject">🚨 [TOMORROW] Final Check — {{ object.name }} | {{ object.journey_start_location }} → {{ object.journey_end_location }}</field>
    <field name="email_from">{{ object.company_id.email or user.email }}</field>
    <field name="email_to">{{ object.user_id.email or object.company_id.email }}</field>
    <field name="auto_delete" eval="True"/>
    <field name="body_html"><![CDATA[
<div style="font-family:'Segoe UI',Arial,sans-serif;background:#f0f2f5;padding:28px 10px;">
<table width="100%" cellpadding="0" cellspacing="0" style="max-width:650px;margin:0 auto;">

  <!-- HEADER -->
  <tr><td style="background:#1a2332;padding:0;border-radius:10px 10px 0 0;overflow:hidden;">
    <table width="100%" cellpadding="0" cellspacing="0">
      <tr><td style="padding:20px 28px 14px;border-bottom:1px solid rgba(255,255,255,0.08);">
        <table width="100%" cellpadding="0" cellspacing="0"><tr>
          <td style="font-family:monospace;color:#fff;font-size:15px;font-weight:700;">
            ANP<span style="color:#f78166;">Fleet</span>
            <span style="color:rgba(255,255,255,0.4);font-size:12px;font-weight:400;margin-left:8px;">/ URGENT Internal Alert</span>
          </td>
          <td align="right"><span style="background:rgba(247,129,102,0.15);color:#f78166;font-size:11px;font-weight:700;padding:3px 10px;border-radius:4px;border:1px solid rgba(247,129,102,0.3);text-transform:uppercase;letter-spacing:1px;">URGENT · Fleet Ops</span></td>
        </tr></table>
      </td></tr>
      <tr><td style="padding:13px 28px;background:rgba(247,129,102,0.15);border-left:3px solid #f78166;">
        <strong style="color:#f78166;font-size:14px;">🚨 &nbsp; FINAL CHECK — Journey Departing TOMORROW — All Prep Must Be Done TODAY</strong>
      </td></tr>
    </table>
  </td></tr>

  <!-- BODY -->
  <tr><td style="background:#fff;padding:26px 28px;">
    <p style="margin:0 0 6px;font-size:15px;font-weight:700;color:#1a2332;">Hello {{ object.user_id.name or 'Fleet Manager' }},</p>
    <p style="margin:0 0 22px;font-size:13px;color:#4a5568;line-height:1.75;">
      <strong style="color:#dc2626;">This booking departs tomorrow.</strong>
      All preparation must be completed <strong>today</strong>.
      Items marked ❌ require <strong>immediate action</strong>.
    </p>

    <!-- BOOKING CARD -->
    <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e2e8f0;border-radius:10px;overflow:hidden;margin-bottom:18px;">
      <tr><td style="background:#1a2332;padding:12px 18px;">
        <table width="100%" cellpadding="0" cellspacing="0"><tr>
          <td style="font-family:monospace;color:#fff;font-size:14px;font-weight:700;">{{ object.name }}</td>
          <td align="right"><span style="background:#fee2e2;color:#991b1b;font-size:11px;font-weight:700;padding:3px 10px;border-radius:12px;text-transform:uppercase;">TOMORROW</span></td>
        </tr></table>
      </td></tr>
      <tr><td style="background:#eef2f7;padding:14px 18px;border-bottom:1px solid #e2e8f0;">
        <table width="100%" cellpadding="0" cellspacing="0"><tr>
          <td width="42%"><div style="font-size:10px;color:#888;text-transform:uppercase;margin-bottom:3px;">Origin</div><div style="font-size:15px;font-weight:700;color:#1a2332;">{{ object.journey_start_location }}</div></td>
          <td width="8%" align="center" style="font-size:16px;color:#f78166;font-weight:700;">→</td>
          <td width="50%"><div style="font-size:10px;color:#888;text-transform:uppercase;margin-bottom:3px;">Destination</div><div style="font-size:15px;font-weight:700;color:#1a2332;">{{ object.journey_end_location }}</div></td>
        </tr></table>
      </td></tr>
      <tr><td><table width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td width="33%" style="padding:11px 16px;border-bottom:1px solid #e2e8f0;border-right:1px solid #e2e8f0;"><div style="font-size:10px;color:#888;text-transform:uppercase;margin-bottom:3px;">TRAVEL DATE</div><div style="font-size:13px;font-weight:700;color:#dc2626;">TOMORROW — {{ object.journey_start_date | date('dd MMM yyyy') }}</div></td>
          <td width="33%" style="padding:11px 16px;border-bottom:1px solid #e2e8f0;border-right:1px solid #e2e8f0;"><div style="font-size:10px;color:#888;text-transform:uppercase;margin-bottom:3px;">Departure</div><div style="font-size:13px;font-weight:700;color:#1a2332;">{{ object.journey_start_time or 'As Scheduled' }}</div></td>
          <td width="34%" style="padding:11px 16px;border-bottom:1px solid #e2e8f0;"><div style="font-size:10px;color:#888;text-transform:uppercase;margin-bottom:3px;">Customer / Phone</div><div style="font-size:13px;font-weight:700;color:#1a2332;">{{ object.customer_id.name }}<br/><span style="font-size:12px;color:#4a5568;">{{ object.customer_phone or '—' }}</span></div></td>
        </tr>
        <tr>
          <td width="33%" style="padding:11px 16px;border-right:1px solid #e2e8f0;"><div style="font-size:10px;color:#888;text-transform:uppercase;margin-bottom:3px;">Vehicle</div>
            {% if object.vehicle_id %}<div style="font-size:13px;font-weight:700;color:#16a34a;">✅ {{ object.vehicle_id.name }}</div>
            {% else %}<div style="font-size:13px;font-weight:700;color:#dc2626;">❌ Not Assigned</div>{% endif %}
          </td>
          <td width="33%" style="padding:11px 16px;border-right:1px solid #e2e8f0;"><div style="font-size:10px;color:#888;text-transform:uppercase;margin-bottom:3px;">Driver</div>
            {% if object.driver_id %}<div style="font-size:13px;font-weight:700;color:#16a34a;">✅ {{ object.driver_id.name }}</div>
            {% else %}<div style="font-size:13px;font-weight:700;color:#dc2626;">❌ Not Assigned</div>{% endif %}
          </td>
          <td width="34%" style="padding:11px 16px;"><div style="font-size:10px;color:#888;text-transform:uppercase;margin-bottom:3px;">Passengers</div><div style="font-size:13px;font-weight:700;color:#1a2332;">{{ object.passenger_count or 1 }}</div></td>
        </tr>
      </table></td></tr>
    </table>

    <!-- PAYMENT BOXES -->
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:18px;"><tr>
      <td width="33%" style="padding-right:5px;"><div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:12px 14px;"><div style="font-size:10px;color:#6b7280;text-transform:uppercase;margin-bottom:4px;">Total Amount</div><div style="font-size:16px;font-weight:700;color:#1d4ed8;">{{ object.currency_id.symbol }} {{ '{:,.0f}'.format(object.total_price or 0) }}</div></div></td>
      <td width="33%" style="padding:0 2px;"><div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:12px 14px;"><div style="font-size:10px;color:#6b7280;text-transform:uppercase;margin-bottom:4px;">Amount Paid</div><div style="font-size:16px;font-weight:700;color:#15803d;">{{ object.currency_id.symbol }} {{ '{:,.0f}'.format(object.amount_paid or 0) }}</div></div></td>
      <td width="34%" style="padding-left:5px;">
        {% if (object.balance_amount or 0) > 0 %}
        <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:12px 14px;"><div style="font-size:10px;color:#6b7280;text-transform:uppercase;margin-bottom:4px;">Balance Due ❌</div><div style="font-size:16px;font-weight:700;color:#dc2626;">{{ object.currency_id.symbol }} {{ '{:,.0f}'.format(object.balance_amount or 0) }}</div></div>
        {% else %}
        <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:12px 14px;"><div style="font-size:10px;color:#6b7280;text-transform:uppercase;margin-bottom:4px;">Balance Due</div><div style="font-size:16px;font-weight:700;color:#15803d;">Fully Paid ✅</div></div>
        {% endif %}
      </td>
    </tr></table>

    <!-- FINAL CHECKLIST -->
    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#dc2626;margin-bottom:10px;padding-bottom:6px;border-bottom:2px solid #fee2e2;">🚨 FINAL Day Checklist — Complete TODAY</div>

    {% if not object.vehicle_id %}
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:6px;"><tr><td style="background:#fef2f2;border:1px solid #fecaca;border-radius:6px;padding:10px 14px;font-size:13px;"><span style="color:#dc2626;margin-right:8px;">❌</span><strong style="color:#dc2626;">CRITICAL — Vehicle Not Assigned. Open Odoo NOW and assign immediately.</strong></td></tr></table>
    {% else %}
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:6px;"><tr><td style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:10px 14px;font-size:13px;color:#374151;"><span style="color:#16a34a;margin-right:8px;">✅</span><strong>Vehicle Ready:</strong> {{ object.vehicle_id.name }} — final inspection, fuel, and documents confirmed</td></tr></table>
    {% endif %}

    {% if not object.driver_id %}
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:6px;"><tr><td style="background:#fef2f2;border:1px solid #fecaca;border-radius:6px;padding:10px 14px;font-size:13px;"><span style="color:#dc2626;margin-right:8px;">❌</span><strong style="color:#dc2626;">CRITICAL — Driver Not Assigned. Assign and brief immediately.</strong></td></tr></table>
    {% else %}
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:6px;"><tr><td style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:10px 14px;font-size:13px;color:#374151;"><span style="color:#16a34a;margin-right:8px;">✅</span><strong>Driver Confirmed:</strong> {{ object.driver_id.name }} — ensure they have customer contact, full route, and pickup address</td></tr></table>
    {% endif %}

    {% if (object.balance_amount or 0) > 0 %}
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:6px;"><tr><td style="background:#fef2f2;border:1px solid #fecaca;border-radius:6px;padding:10px 14px;font-size:13px;"><span style="color:#dc2626;margin-right:8px;">❌</span><strong style="color:#dc2626;">Payment Outstanding:</strong><span style="color:#dc2626;"> {{ object.currency_id.symbol }} {{ '{:,.0f}'.format(object.balance_amount) }} — collect before boarding</span></td></tr></table>
    {% endif %}

    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:6px;"><tr><td style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:10px 14px;font-size:13px;color:#374151;"><span style="color:#d97706;margin-right:8px;">⚠️</span><strong>Customer Call:</strong> Call customer to confirm pickup point, time, and any last-minute changes</td></tr></table>
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:6px;"><tr><td style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:10px 14px;font-size:13px;color:#374151;"><span style="color:#d97706;margin-right:8px;">⚠️</span><strong>Backup Standby:</strong> Keep backup vehicle and driver available for emergencies</td></tr></table>

    {% if object.reminder_1day_sent %}
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:6px;"><tr><td style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:10px 14px;font-size:13px;color:#374151;"><span style="color:#16a34a;margin-right:8px;">✅</span><strong>Customer Notified:</strong> 1-day final reminder sent to {{ object.customer_email }}</td></tr></table>
    {% else %}
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:6px;"><tr><td style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:10px 14px;font-size:13px;color:#374151;"><span style="color:#d97706;margin-right:8px;">⚠️</span><strong>Customer Reminder:</strong> 1-day reminder not sent — check mail queue or resend manually</td></tr></table>
    {% endif %}

    {% if object.transport_notes or object.notes %}
    <div style="background:#fafafa;border:1px solid #e5e7eb;border-radius:8px;padding:12px 16px;font-size:13px;color:#6b7280;line-height:1.65;margin:12px 0 18px;">
      <strong style="color:#374151;display:block;margin-bottom:5px;font-size:11px;text-transform:uppercase;">Transport / Booking Notes</strong>
      {{ object.transport_notes or object.notes }}
    </div>
    {% endif %}

    <table width="100%" cellpadding="0" cellspacing="0" style="margin:14px 0 18px;"><tr>
      <td width="48%" style="padding-right:6px;"><a href="/web#id={{ object.id }}&amp;model=fleet.booking&amp;view_type=form" style="display:block;background:#dc2626;color:#fff;text-align:center;padding:12px;border-radius:8px;text-decoration:none;font-size:13px;font-weight:600;">Open Booking NOW →</a></td>
      {% if object.invoice_url %}<td width="30%" style="padding-left:3px;"><a href="{{ object.invoice_url }}" style="display:block;background:#f1f5f9;color:#1a2332;text-align:center;padding:12px;border-radius:8px;text-decoration:none;font-size:13px;font-weight:600;border:1px solid #e2e8f0;">View Invoice</a></td>{% endif %}
    </tr></table>
    <p style="font-size:12px;color:#9ca3af;margin:0;">Automated internal notification — do not reply.</p>
  </td></tr>

  <!-- FOOTER -->
  <tr><td style="background:#1a2332;padding:16px 28px;border-radius:0 0 10px 10px;text-align:center;">
    <p style="margin:0;font-size:11px;color:rgba(255,255,255,0.4);">
      {{ object.company_id.name }} · Fleet Operations · <span style="color:#f78166;">Internal Use Only</span>
    </p>
  </td></tr>

</table>
</div>
    ]]></field>
</record>


<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!--  ⑤  SCHEDULED ACTION — Daily at 08:00 AM IST (02:30 UTC)               -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<record id="ir_cron_fleet_booking_journey_reminder" model="ir.cron">
    <field name="name">Fleet Booking: Send Journey Reminder Emails (Customer + Manager)</field>
    <field name="model_id" ref="fleet_booking.model_fleet_booking"/>
    <field name="state">code</field>
    <field name="code">model.action_send_journey_reminders()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <!--
        nextcall = tomorrow at 02:30 UTC = 08:00 AM IST
        Adjust if your Odoo server is in a different timezone.
    -->
    <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=2, minute=30, second=0)"/>
    <field name="numbercall">-1</field>
    <field name="active" eval="True"/>
    <field name="user_id" ref="base.user_root"/>
</record>

</odoo>
