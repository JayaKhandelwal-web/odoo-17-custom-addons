<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Register the invoice report -->
    <record id="action_report_fleet_booking_invoice" model="ir.actions.report">
        <field name="name">Booking Invoice</field>
        <field name="model">fleet.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fleet_booking.report_fleet_booking_invoice</field>
        <field name="report_file">fleet_booking.report_fleet_booking_invoice</field>
        <field name="print_report_name">'Invoice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_fleet_booking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- NEW: Register the shareable invoice report -->
    <record id="action_report_fleet_booking_shareable_invoice" model="ir.actions.report">
        <field name="name">Shareable Booking Invoice</field>
        <field name="model">fleet.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fleet_booking.public_invoice_template</field>
        <field name="report_file">fleet_booking.public_invoice_template</field>
        <field name="print_report_name">'Shareable-Invoice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_fleet_booking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- URL routing configuration -->
    <record id="fleet_booking_public_route" model="ir.config_parameter">
        <field name="key">fleet_booking.public_invoice_enabled</field>
        <field name="value">True</field>
    </record>

    <!-- Security configuration for public access -->
    <record id="fleet_booking_public_security" model="ir.config_parameter">
        <field name="key">fleet_booking.public_invoice_security</field>
        <field name="value">token_based</field>
    </record>

    <!-- Token expiry configuration (in days, 0 means no expiry) -->
    <record id="fleet_booking_token_expiry" model="ir.config_parameter">
        <field name="key">fleet_booking.invoice_token_expiry_days</field>
        <field name="value">0</field>
    </record>
</odoo>