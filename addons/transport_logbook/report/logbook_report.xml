<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format Definition with minimal margins -->
    <record id="paperformat_transport_logbook" model="report.paperformat">
        <field name="name">Transport Logbook Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">15</field>
        <field name="dpi">90</field>
    </record>
    
    <!-- Single print action for selected records -->
    <record id="action_report_selected_logbook" model="ir.actions.report">
        <field name="name">Print Selected Records</field>
        <field name="model">transport.logbook.entry</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_logbook.report_logbook_document_clean</field>
        <field name="report_file">transport_logbook.report_logbook_document_clean</field>
        <field name="paperformat_id" ref="paperformat_transport_logbook"/>
        <field name="print_report_name">'Logbook Report'</field>
        <field name="binding_model_id" ref="model_transport_logbook_entry"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list</field>
    </record>
    
    <!-- Hidden report actions for different report types -->
    <record id="action_report_bus_logbook" model="ir.actions.report">
        <field name="name">Bus Logbook Report</field>
        <field name="model">transport.logbook.entry</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_logbook.report_logbook_document_clean</field>
        <field name="report_file">transport_logbook.report_logbook_document_clean</field>
        <field name="paperformat_id" ref="paperformat_transport_logbook"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Bus Logbook Report'</field>
    </record>
    
    <record id="action_report_cab_logbook" model="ir.actions.report">
        <field name="name">Cab Logbook Report</field>
        <field name="model">transport.logbook.entry</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_logbook.report_logbook_document_clean</field>
        <field name="report_file">transport_logbook.report_logbook_document_clean</field>
        <field name="paperformat_id" ref="paperformat_transport_logbook"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Cab Logbook Report'</field>
    </record>
    
    <record id="action_report_company_logbook" model="ir.actions.report">
        <field name="name">Company Logbook Report</field>
        <field name="model">transport.logbook.entry</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_logbook.report_logbook_document_clean</field>
        <field name="report_file">transport_logbook.report_logbook_document_clean</field>
        <field name="paperformat_id" ref="paperformat_transport_logbook"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Company Logbook Report'</field>
    </record>
</odoo>
