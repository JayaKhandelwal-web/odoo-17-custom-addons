<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_check_device_status" model="ir.cron">
            <field name="name">ZKTeco: Check Device Status</field>
            <field name="model_id" ref="model_zk_device"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_device_status()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_check_absent_employees" model="ir.cron">
            <field name="name">Attendance: Notify Manager of Absent Employees</field>
            <field name="model_id" ref="model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_absent_employees()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
