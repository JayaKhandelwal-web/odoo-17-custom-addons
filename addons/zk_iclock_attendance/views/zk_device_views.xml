<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zk_device_form" model="ir.ui.view">
        <field name="name">zk.device.form</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <form string="ZKTeco Device">
                <header>
                    <button name="action_show_configuration" string="Show Configuration" type="object" class="btn-primary"/>
                    <button name="action_sync_employees" string="Sync All Employees" type="object" class="btn-success"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employees" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="employee_count" widget="statinfo" string="Employees"/>
                        </button>
                        <button name="action_view_attendance" type="object" class="oe_stat_button" icon="fa-calendar-check-o">
                            <field name="total_records_received" widget="statinfo" string="Records"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="serial_number"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="last_connection"/>
                            <field name="server_url"/>
                            <field name="server_port"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zk_device_tree" model="ir.ui.view">
        <field name="name">zk.device.tree</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <tree string="Devices" decoration-success="state=='connected'" decoration-danger="state=='disconnected'">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="location"/>
                <field name="employee_count"/>
                <field name="last_connection"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="action_zk_device" model="ir.actions.act_window">
        <field name="name">Biometric Devices</field>
        <field name="res_model">zk.device</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
