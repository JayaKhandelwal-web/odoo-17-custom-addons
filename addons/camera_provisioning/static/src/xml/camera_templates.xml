<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- BLE Scan Main Template -->
    <t t-name="camera_provisioning.BLEScanTemplate">
        <div class="o_camera_ble_scan container-fluid p-4">
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-6">
                    
                    <!-- Header -->
                    <div class="text-center mb-4">
                        <h2>📹 Camera WiFi Setup</h2>
                        <p class="text-muted">Connect your CCTV camera to WiFi via Bluetooth</p>
                    </div>
                    
                    <!-- Browser Support Warning -->
                    <div t-if="!state.isSupported" class="alert alert-danger">
                        <strong>⚠️ Browser Not Supported</strong>
                        <p class="mb-0">Web Bluetooth is required. Please use:</p>
                        <ul class="mb-0">
                            <li>Google Chrome (recommended)</li>
                            <li>Microsoft Edge</li>
                            <li>Opera</li>
                        </ul>
                    </div>
                    
                    <!-- HTTPS Warning -->
                    <div t-if="state.isSupported and !state.isSecure" class="alert alert-warning">
                        <strong>🔒 HTTPS Required</strong>
                        <p class="mb-0">Web Bluetooth requires a secure connection. Please access Odoo via HTTPS.</p>
                    </div>
                    
                    <!-- Main Content -->
                    <div t-if="state.isSupported and state.isSecure" class="card">
                        <div class="card-body">
                            
                            <!-- Status Display -->
                            <div class="text-center mb-4">
                                <div t-if="state.status === 'idle'" class="status-icon text-muted">
                                    <i class="fa fa-bluetooth fa-4x"></i>
                                </div>
                                <div t-if="state.status === 'scanning'" class="status-icon text-primary">
                                    <i class="fa fa-spinner fa-spin fa-4x"></i>
                                </div>
                                <div t-if="state.status === 'found'" class="status-icon text-success">
                                    <i class="fa fa-check-circle fa-4x"></i>
                                </div>
                                <div t-if="state.status === 'connecting'" class="status-icon text-info">
                                    <i class="fa fa-wifi fa-4x"></i>
                                </div>
                                <div t-if="state.status === 'success'" class="status-icon text-success">
                                    <i class="fa fa-check fa-4x"></i>
                                </div>
                                <div t-if="state.status === 'error'" class="status-icon text-danger">
                                    <i class="fa fa-exclamation-circle fa-4x"></i>
                                </div>
                                
                                <p t-if="state.statusMessage" class="mt-3 status-message">
                                    <t t-esc="state.statusMessage"/>
                                </p>
                            </div>
                            
                            <!-- Scan Button -->
                            <div t-if="!state.showWifiForm" class="text-center">
                                <button class="btn btn-primary btn-lg" 
                                        t-on-click="scanForCamera"
                                        t-att-disabled="state.status === 'scanning'">
                                    <i class="fa fa-bluetooth me-2"></i>
                                    Scan for Camera
                                </button>
                                <p class="text-muted mt-3">
                                    <small>Make sure your camera is in pairing mode (reset it first)</small>
                                </p>
                            </div>
                            
                            <!-- WiFi Form -->
                            <div t-if="state.showWifiForm" class="wifi-form">
                                <div t-if="state.device" class="alert alert-success mb-3">
                                    <strong>Camera Found:</strong> <t t-esc="state.device.name"/>
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label">WiFi Network Name (SSID)</label>
                                    <input type="text" class="form-control" 
                                           t-model="state.ssid"
                                           placeholder="Your WiFi network name"
                                           t-att-disabled="state.isProvisioning"/>
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label">WiFi Password</label>
                                    <input type="password" class="form-control"
                                           t-model="state.password"
                                           placeholder="WiFi password"
                                           t-att-disabled="state.isProvisioning"/>
                                </div>
                                
                                <div class="d-flex gap-2">
                                    <button class="btn btn-primary flex-grow-1"
                                            t-on-click="provisionWifi"
                                            t-att-disabled="state.isProvisioning">
                                        <i class="fa fa-wifi me-2"></i>
                                        <t t-if="state.isProvisioning">
                                            <i class="fa fa-spinner fa-spin me-1"></i> Connecting...
                                        </t>
                                        <t t-else="">Connect Camera to WiFi</t>
                                    </button>
                                    <button class="btn btn-secondary" t-on-click="cancel"
                                            t-att-disabled="state.isProvisioning">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                            
                            <!-- Success State -->
                            <div t-if="state.status === 'success'" class="text-center mt-4">
                                <div class="alert alert-success">
                                    <i class="fa fa-check-circle me-2"></i>
                                    Camera successfully connected to WiFi!
                                </div>
                            </div>
                            
                        </div>
                    </div>
                    
                    <!-- Instructions -->
                    <div class="card mt-4">
                        <div class="card-header">
                            <h5 class="mb-0">📋 Instructions</h5>
                        </div>
                        <div class="card-body">
                            <ol class="mb-0">
                                <li><strong>Reset your camera</strong> - Put it in pairing mode (usually hold reset button for 5-10 seconds until you hear a beep)</li>
                                <li><strong>Click "Scan for Camera"</strong> - Your browser will show a popup with available devices</li>
                                <li><strong>Select your camera</strong> - Look for "XM" or "BallCamera" in the list</li>
                                <li><strong>Enter WiFi credentials</strong> - Use your 2.4GHz WiFi network (most cameras don't support 5GHz)</li>
                                <li><strong>Wait for connection</strong> - Camera will connect and appear on your network</li>
                            </ol>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    </t>

    <!-- Provision Action Template (used from camera form) -->
    <t t-name="camera_provisioning.ProvisionActionTemplate">
        <div class="o_camera_provision_action container p-4">
            <div class="text-center">
                <h3>📶 Provisioning Camera</h3>
                
                <div class="my-4">
                    <div t-if="state.status === 'ready'" class="text-muted">
                        <i class="fa fa-bluetooth fa-3x"></i>
                    </div>
                    <div t-elif="state.status === 'scanning' or state.status === 'connecting'" class="text-primary">
                        <i class="fa fa-spinner fa-spin fa-3x"></i>
                    </div>
                    <div t-elif="state.status === 'success'" class="text-success">
                        <i class="fa fa-check-circle fa-3x"></i>
                    </div>
                    <div t-else="" class="text-danger">
                        <i class="fa fa-exclamation-circle fa-3x"></i>
                    </div>
                </div>
                
                <p class="status-message"><t t-esc="state.statusMessage"/></p>
                
                <div t-if="state.status === 'ready'" class="mt-3">
                    <p><strong>SSID:</strong> <t t-esc="state.ssid"/></p>
                    <button class="btn btn-primary" t-on-click="startProvisioning">
                        <i class="fa fa-play me-2"></i> Start Provisioning
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
