<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Camera Form View -->
    <record id="view_cctv_camera_form" model="ir.ui.view">
        <field name="name">cctv.camera.form</field>
        <field name="model">cctv.camera</field>
        <field name="arch" type="xml">
            <form string="CCTV Camera">
                <header>
                    <button name="action_provision_wifi" type="object" 
                            string="📶 Setup WiFi via Bluetooth" class="btn-primary"
                            invisible="state not in ('new', 'error')"/>
                    <button name="action_test_connection" type="object"
                            string="🔍 Test Connection" class="btn-secondary"
                            invisible="state in ('new', 'provisioning')"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="new,configured,online"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Camera Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Device Info">
                            <field name="mac_address"/>
                            <field name="serial_number"/>
                            <field name="location"/>
                            <field name="location_name"/>
                        </group>
                        <group string="Network">
                            <field name="ip_address"/>
                            <field name="router_ddns"/>
                            <field name="external_port"/>
                        </group>
                    </group>
                    <group>
                        <group string="RTSP Settings">
                            <field name="rtsp_port"/>
                            <field name="rtsp_path"/>
                            <field name="rtsp_username"/>
                            <field name="rtsp_password" password="True"/>
                        </group>
                        <group string="WiFi Status">
                            <field name="wifi_ssid" readonly="1"/>
                            <field name="wifi_configured"/>
                            <field name="provisioning_date"/>
                            <field name="last_seen"/>
                        </group>
                    </group>
                    <group string="Stream URLs" invisible="not ip_address">
                        <field name="rtsp_url" widget="CopyClipboardChar"/>
                        <field name="rtsp_external_url" widget="CopyClipboardChar"/>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                        <page string="Live View" name="live_view">
                            <div class="camera-live-view" style="text-align: center; padding: 20px;">
                                <p class="text-muted">
                                    Live view requires HLS stream setup. 
                                    Use the RTSP URL with a streaming server.
                                </p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Camera Tree View -->
    <record id="view_cctv_camera_tree" model="ir.ui.view">
        <field name="name">cctv.camera.tree</field>
        <field name="model">cctv.camera</field>
        <field name="arch" type="xml">
            <tree string="CCTV Cameras" decoration-success="state == 'online'" 
                  decoration-danger="state in ('error', 'offline')"
                  decoration-warning="state == 'provisioning'">
                <field name="name"/>
                <field name="location_name"/>
                <field name="ip_address"/>
                <field name="mac_address"/>
                <field name="wifi_configured"/>
                <field name="state"/>
                <field name="last_seen"/>
            </tree>
        </field>
    </record>

    <!-- Camera Kanban View -->
    <record id="view_cctv_camera_kanban" model="ir.ui.view">
        <field name="name">cctv.camera.kanban</field>
        <field name="model">cctv.camera</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="state"/>
                <field name="location_name"/>
                <field name="wifi_configured"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="state" widget="label_selection" 
                                           options="{'classes': {'new': 'default', 'configured': 'info', 'online': 'success', 'offline': 'danger', 'error': 'danger'}}"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span><field name="location_name"/></span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-if="record.wifi_configured.raw_value" 
                                              class="badge bg-success">WiFi ✓</span>
                                        <span t-else="" class="badge bg-warning">No WiFi</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Camera Search View -->
    <record id="view_cctv_camera_search" model="ir.ui.view">
        <field name="name">cctv.camera.search</field>
        <field name="model">cctv.camera</field>
        <field name="arch" type="xml">
            <search string="Search Cameras">
                <field name="name"/>
                <field name="mac_address"/>
                <field name="location_name"/>
                <filter name="online" string="Online" domain="[('state', '=', 'online')]"/>
                <filter name="offline" string="Offline" domain="[('state', '=', 'offline')]"/>
                <filter name="not_configured" string="Not Configured" 
                        domain="[('wifi_configured', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_location" string="Location" context="{'group_by': 'location'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Camera Action -->
    <record id="action_cctv_camera" model="ir.actions.act_window">
        <field name="name">CCTV Cameras</field>
        <field name="res_model">cctv.camera</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_cctv_camera_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first CCTV Camera
            </p>
            <p>
                Click the "+" button to add a camera, then use 
                "Setup WiFi via Bluetooth" to provision it.
            </p>
        </field>
    </record>

    <!-- Provisioning Wizard Form -->
    <record id="view_cctv_camera_provision_wizard_form" model="ir.ui.view">
        <field name="name">cctv.camera.provision.wizard.form</field>
        <field name="model">cctv.camera.provision.wizard</field>
        <field name="arch" type="xml">
            <form string="WiFi Provisioning">
                <group>
                    <field name="camera_id" readonly="1"/>
                    <field name="wifi_ssid" placeholder="Your WiFi network name"/>
                    <field name="wifi_password" password="True" placeholder="WiFi password"/>
                </group>
                <footer>
                    <button name="action_provision" type="object" string="📶 Connect Camera" 
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
