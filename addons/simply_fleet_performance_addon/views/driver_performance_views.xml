<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Performance Tree View -->
    <record id="view_driver_performance_tree" model="ir.ui.view">
        <field name="name">simply.fleet.driver.performance.tree</field>
        <field name="model">simply.fleet.driver.performance</field>
        <field name="arch" type="xml">
            <tree string="Driver Performance" decoration-success="performance_grade=='excellent'" 
                  decoration-info="performance_grade=='good'" decoration-warning="performance_grade=='average'"
                  decoration-danger="performance_grade in ['below_average', 'poor']">
                <field name="name"/>
                <field name="driver_id"/>
                <field name="period_type"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="total_trips"/>
                <field name="total_distance" sum="Total Distance"/>
                <field name="average_mileage" widget="float" digits="[16,2]"/>
                <field name="performance_score" widget="progressbar"/>
                <field name="performance_grade"/>
                <field name="reward_points"/>
                <field name="reward_amount" sum="Total Rewards"/>
                <field name="rank"/>
                <field name="state" widget="badge" 
                       decoration-success="state=='rewarded'" 
                       decoration-info="state=='approved'"
                       decoration-warning="state=='calculated'"/>
            </tree>
        </field>
    </record>

    <!-- Performance Form View -->
    <record id="view_driver_performance_form" model="ir.ui.view">
        <field name="name">simply.fleet.driver.performance.form</field>
        <field name="model">simply.fleet.driver.performance</field>
        <field name="arch" type="xml">
            <form string="Driver Performance">
                <header>
                    <button name="action_calculate_performance" string="Calculate Performance" 
                            type="object" class="btn-primary" 
                            invisible="state not in ['draft']"/>
                    <button name="action_approve" string="Approve" 
                            type="object" class="btn-primary" 
                            invisible="state not in ['calculated']"/>
                    <button name="action_mark_rewarded" string="Mark as Rewarded" 
                            type="object" class="btn-success" 
                            invisible="state not in ['approved']"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" 
                            type="object" invisible="state in ['draft']"/>
                    <button name="action_view_fuel_logs" string="View Fuel Logs" 
                            type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,calculated,approved,rewarded"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_fuel_logs" 
                                type="object" icon="fa-gas-pump">
                            <field string="Trips" name="total_trips" widget="statinfo"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Excellent Driver" 
                            bg_color="text-bg-success" 
                            invisible="performance_grade != 'excellent'"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Driver &amp; Period Information">
                            <field name="driver_id" options="{'no_create': True}"/>
                            <field name="period_type"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group string="Performance Score">
                            <field name="performance_score" widget="percentpie"/>
                            <field name="performance_grade"/>
                            <field name="rank"/>
                            <field name="total_drivers"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Performance Metrics">
                            <group>
                                <group string="Distance &amp; Fuel">
                                    <field name="total_distance"/>
                                    <field name="total_fuel_consumed"/>
                                    <field name="average_mileage" widget="float" digits="[16,2]"/>
                                    <field name="best_mileage" widget="float" digits="[16,2]"/>
                                    <field name="worst_mileage" widget="float" digits="[16,2]"/>
                                </group>
                                <group string="Cost Analysis">
                                    <field name="total_fuel_cost"/>
                                    <field name="cost_per_km" widget="monetary"/>
                                </group>
                            </group>
                        </page>

                        <page string="Rewards">
                            <group>
                                <group>
                                    <field name="reward_points"/>
                                    <field name="reward_amount" widget="monetary"/>
                                </group>
                            </group>
                            <group string="Reward Breakdown">
                                <div class="alert alert-info" role="alert">
                                    <h4 class="alert-heading">Performance Grade Based Rewards:</h4>
                                    <ul>
                                        <li><strong>Excellent (90-100):</strong> 100 points base</li>
                                        <li><strong>Good (75-89):</strong> 75 points base</li>
                                        <li><strong>Average (60-74):</strong> 50 points base</li>
                                        <li><strong>Below Average (40-59):</strong> 25 points base</li>
                                        <li><strong>Poor (0-39):</strong> 0 points</li>
                                    </ul>
                                    <p><strong>Bonus:</strong> +20 points for scores ≥ 95</p>
                                    <p><strong>Conversion:</strong> ₹10 per point (1.5x multiplier for monthly)</p>
                                </div>
                            </group>
                        </page>

                        <page string="Fuel Logs">
                            <field name="fuel_log_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="vehicle_id"/>
                                    <field name="liters"/>
                                    <field name="distance_travelled"/>
                                    <field name="mileage"/>
                                    <field name="total_amount"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Performance Kanban View -->
    <record id="view_driver_performance_kanban" model="ir.ui.view">
        <field name="name">simply.fleet.driver.performance.kanban</field>
        <field name="model">simply.fleet.driver.performance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="driver_id"/>
                <field name="period_type"/>
                <field name="performance_score"/>
                <field name="performance_grade"/>
                <field name="reward_amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb16">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="driver_id"/>
                                    </strong>
                                </div>
                                <span class="badge rounded-pill"
                                      t-att-class="{'text-bg-success': record.performance_grade.raw_value=='excellent',
                                                   'text-bg-info': record.performance_grade.raw_value=='good',
                                                   'text-bg-warning': record.performance_grade.raw_value=='average',
                                                   'text-bg-danger': record.performance_grade.raw_value in ['below_average', 'poor']}">
                                    <field name="performance_grade"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="period_start"/> - <field name="period_end"/>
                                <div class="mt-2">
                                    <strong>Score: </strong>
                                    <field name="performance_score" widget="progressbar"/>
                                </div>
                                <div class="mt-2">
                                    <strong>Reward: ₹</strong>
                                    <field name="reward_amount"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="state" widget="badge"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="period_type" widget="badge"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Performance Search View -->
    <record id="view_driver_performance_search" model="ir.ui.view">
        <field name="name">simply.fleet.driver.performance.search</field>
        <field name="model">simply.fleet.driver.performance</field>
        <field name="arch" type="xml">
            <search string="Driver Performance">
                <field name="name"/>
                <field name="driver_id"/>
                <field name="period_start"/>
                <field name="period_end"/>

                <filter string="Weekly" name="weekly"
                        domain="[('period_type', '=', 'weekly')]"/>
                <filter string="Monthly" name="monthly"
                        domain="[('period_type', '=', 'monthly')]"/>

                <separator/>

                <filter string="Excellent" name="excellent"
                        domain="[('performance_grade', '=', 'excellent')]"/>
                <filter string="Good" name="good"
                        domain="[('performance_grade', '=', 'good')]"/>
                <filter string="Average" name="average"
                        domain="[('performance_grade', '=', 'average')]"/>
                <filter string="Below Average" name="below_average"
                        domain="[('performance_grade', '=', 'below_average')]"/>

                <separator/>

                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Calculated" name="calculated"
                        domain="[('state', '=', 'calculated')]"/>
                <filter string="Approved" name="approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Rewarded" name="rewarded"
                        domain="[('state', '=', 'rewarded')]"/>

                <separator/>

                <filter string="This Week" name="this_week"
                        domain="[('period_start', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                                ('period_end', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('period_start', '&gt;=', context_today().strftime('%Y-%m-01')),
                                ('period_end', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last Month" name="last_month"
                        domain="[('period_start', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01')),
                                ('period_end', '&lt;=', (context_today().replace(day=1) - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Group By">
                    <filter string="Driver" name="group_driver"
                            context="{'group_by': 'driver_id'}"/>
                    <filter string="Period Type" name="group_period_type"
                            context="{'group_by': 'period_type'}"/>
                    <filter string="Performance Grade" name="group_grade"
                            context="{'group_by': 'performance_grade'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Period Start" name="group_period_start"
                            context="{'group_by': 'period_start'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Performance Graph View - Line Chart -->
    <record id="view_driver_performance_graph" model="ir.ui.view">
        <field name="name">simply.fleet.driver.performance.graph</field>
        <field name="model">simply.fleet.driver.performance</field>
        <field name="arch" type="xml">
            <graph string="Driver Performance Analysis" type="line" sample="1">
                <field name="period_start" type="row" interval="week"/>
                <field name="performance_score" type="measure"/>
                <field name="average_mileage" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Performance Pivot View -->
    <record id="view_driver_performance_pivot" model="ir.ui.view">
        <field name="name">simply.fleet.driver.performance.pivot</field>
        <field name="model">simply.fleet.driver.performance</field>
        <field name="arch" type="xml">
            <pivot string="Performance Analysis">
                <field name="driver_id" type="row"/>
                <field name="period_start" type="col" interval="week"/>
                <field name="performance_score" type="measure"/>
                <field name="average_mileage" type="measure"/>
                <field name="total_distance" type="measure"/>
                <field name="reward_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Performance Calendar View -->
    <record id="view_driver_performance_calendar" model="ir.ui.view">
        <field name="name">simply.fleet.driver.performance.calendar</field>
        <field name="model">simply.fleet.driver.performance</field>
        <field name="arch" type="xml">
            <calendar string="Performance Calendar" date_start="period_start"
                     date_stop="period_end" color="performance_grade" mode="month">
                <field name="driver_id"/>
                <field name="performance_score"/>
                <field name="performance_grade"/>
            </calendar>
        </field>
    </record>

    <!-- Performance Dashboard Action -->
    <record id="action_driver_performance_dashboard" model="ir.actions.act_window">
        <field name="name">Performance Dashboard</field>
        <field name="res_model">simply.fleet.driver.performance</field>
        <field name="view_mode">kanban,graph,pivot,tree,form,calendar</field>
        <field name="context">{
            'search_default_this_month': 1,
            'search_default_group_driver': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No performance records found. Create one!
            </p>
            <p>
                Track driver performance based on fuel efficiency, mileage, and costs.
            </p>
        </field>
    </record>

    <!-- Performance Action -->
    <record id="action_driver_performance" model="ir.actions.act_window">
        <field name="name">Driver Performance</field>
        <field name="res_model">simply.fleet.driver.performance</field>
        <field name="view_mode">tree,form,kanban,graph,pivot,calendar</field>
        <field name="context">{
            'search_default_this_month': 1
        }</field>
    </record>

    <!-- Performance Comparison Wizard Form -->
    <record id="view_driver_performance_comparison_form" model="ir.ui.view">
        <field name="name">simply.fleet.driver.performance.comparison.form</field>
        <field name="model">simply.fleet.driver.performance.comparison</field>
        <field name="arch" type="xml">
            <form string="Performance Comparison">
                <group>
                    <group>
                        <field name="period_type"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="driver_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button string="Generate Comparison" name="action_generate_comparison"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Performance Comparison Action -->
    <record id="action_driver_performance_comparison" model="ir.actions.act_window">
        <field name="name">Compare Drivers</field>
        <field name="res_model">simply.fleet.driver.performance.comparison</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Top Performers Dashboard Action -->
    <record id="action_top_performers" model="ir.actions.act_window">
        <field name="name">Top Performers</field>
        <field name="res_model">simply.fleet.driver.performance</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('performance_grade', 'in', ['excellent', 'good'])]</field>
        <field name="context">{
            'search_default_this_month': 1
        }</field>
    </record>

    <!-- Menu Items -->
    <!-- Main Performance Menu -->
    <menuitem id="menu_fleet_performance_root"
              name="Performance"
              parent="simply_fleet.menu_simply_fleet_root"
              sequence="35"/>

    <!-- Dashboard Menu -->
    <menuitem id="menu_fleet_performance_dashboard"
              name="Dashboard"
              parent="menu_fleet_performance_root"
              action="action_driver_performance_dashboard"
              sequence="1"/>

    <!-- Driver Performance Menu -->
    <menuitem id="menu_driver_performance"
              name="Driver Performance"
              parent="menu_fleet_performance_root"
              action="action_driver_performance"
              sequence="10"/>

    <!-- Top Performers Menu -->
    <menuitem id="menu_top_performers"
              name="Top Performers"
              parent="menu_fleet_performance_root"
              action="action_top_performers"
              sequence="20"/>

    <!-- Compare Drivers Menu -->
    <menuitem id="menu_driver_comparison"
              name="Compare Drivers"
              parent="menu_fleet_performance_root"
              action="action_driver_performance_comparison"
              sequence="30"/>

</odoo>