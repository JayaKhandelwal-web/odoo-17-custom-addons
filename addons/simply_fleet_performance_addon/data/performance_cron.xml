<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job for Weekly Performance Generation -->
        <record id="ir_cron_generate_weekly_performance" model="ir.cron">
            <field name="name">Generate Weekly Driver Performance</field>
            <field name="model_id" ref="model_simply_fleet_driver_performance"/>
            <field name="state">code</field>
            <field name="code">model.generate_weekly_performance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=(7-DateTime.now().weekday()))).strftime('%Y-%m-%d 00:00:00')"/>
        </record>

        <!-- Cron Job for Monthly Performance Generation -->
        <record id="ir_cron_generate_monthly_performance" model="ir.cron">
            <field name="name">Generate Monthly Driver Performance</field>
            <field name="model_id" ref="model_simply_fleet_driver_performance"/>
            <field name="state">code</field>
            <field name="code">model.generate_monthly_performance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="nextcall" eval="(DateTime.now().replace(day=1) + relativedelta(months=1)).strftime('%Y-%m-01 00:00:00')"/>
        </record>
    </data>
</odoo>
