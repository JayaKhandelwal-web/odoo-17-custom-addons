<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice Archive Menu -->
    <menuitem id="menu_fleet_booking_invoice_archive"
              name="Invoice Archive"
              parent="fleet_booking.menu_fleet_booking_root"
              sequence="45"/>

    <menuitem id="menu_fleet_booking_invoice_documents_all"
              name="All Invoice Documents"
              parent="menu_fleet_booking_invoice_archive"
              action="action_fleet_booking_invoice_documents"
              sequence="1"/>

    <menuitem id="menu_fleet_booking_invoice_documents_quotation"
              name="Quotation Invoices"
              parent="menu_fleet_booking_invoice_archive"
              action="action_fleet_booking_invoice_documents"
              sequence="2"/>

    <menuitem id="menu_fleet_booking_invoice_documents_confirmed"
              name="Confirmed Invoices"
              parent="menu_fleet_booking_invoice_archive"
              action="action_fleet_booking_invoice_documents"
              sequence="3"/>

    <menuitem id="menu_fleet_booking_invoice_documents_completed"
              name="Completed Invoices"
              parent="menu_fleet_booking_invoice_archive"
              action="action_fleet_booking_invoice_documents"
              sequence="4"/>

    <!-- Actions for filtered views -->
    <record id="action_fleet_booking_invoice_documents_quotation" model="ir.actions.act_window">
        <field name="name">Quotation Invoices</field>
        <field name="res_model">fleet.booking.invoice.document</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('booking_state', '=', 'quotation')]</field>
        <field name="context">{'search_default_quotation_stage': 1}</field>
    </record>

    <record id="action_fleet_booking_invoice_documents_confirmed" model="ir.actions.act_window">
        <field name="name">Confirmed Invoices</field>
        <field name="res_model">fleet.booking.invoice.document</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('booking_state', '=', 'confirmed')]</field>
        <field name="context">{'search_default_confirmed_stage': 1}</field>
    </record>

    <record id="action_fleet_booking_invoice_documents_completed" model="ir.actions.act_window">
        <field name="name">Completed Invoices</field>
        <field name="res_model">fleet.booking.invoice.document</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('booking_state', '=', 'completed')]</field>
        <field name="context">{'search_default_completed_stage': 1}</field>
    </record>

    <!-- Update menu items with correct actions -->
    <record id="menu_fleet_booking_invoice_documents_quotation" model="ir.ui.menu">
        <field name="action" ref="action_fleet_booking_invoice_documents_quotation"/>
    </record>

    <record id="menu_fleet_booking_invoice_documents_confirmed" model="ir.ui.menu">
        <field name="action" ref="action_fleet_booking_invoice_documents_confirmed"/>
    </record>

    <record id="menu_fleet_booking_invoice_documents_completed" model="ir.ui.menu">
        <field name="action" ref="action_fleet_booking_invoice_documents_completed"/>
    </record>
</odoo>