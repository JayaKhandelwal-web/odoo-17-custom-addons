<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Employee Sequence Definition -->
        <record id="employee_sequence_no" model="ir.sequence">
            <field name="name">Employee Sequence</field>
            <field name="code">seqemp.seqemp</field>
            <field name="prefix">EMP</field>
            <field name="padding">5</field>
            <field name="implementation">no_gap</field>
        </record>

        <!-- Enhanced Employee Form View Extension -->
        <record id="employee_form_view" model="ir.ui.view">
            <field name="name">employee.form.view</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='department_id']" position="before">
                    <field name="emp_id" string="Employee ID" readonly="1"/>
                </xpath>
                <xpath expr="//field[@name='work_location_id']" position="after">
                    <field name="joined_date" string="Joined Date"/>
                    <field name="expired_date" string="ID Card Expiry Date"/>
                </xpath>
                
                <!-- Smart Buttons Section -->
                <div name="button_box" position="inside">
                    <!-- Generate ID Card Button -->
                    <button name="%(jt_employee_icard.action_print_employee_idcard)d" 
                            type="action"
                            class="oe_stat_button"
                            icon="fa-id-card">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Generate ID Card</span>
                        </div>
                    </button>
                    
                    <!-- Generate Employee ID Button (shows only if ID is missing/New) -->
                    <button name="action_generate_employee_id"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-hashtag"
                            invisible="emp_id and emp_id != 'New'">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Generate Employee ID</span>
                        </div>
                    </button>
                </div>
            </field>
        </record>

        <!-- Employee List View with Bulk Actions -->
        <record id="employee_list_view_with_actions" model="ir.ui.view">
            <field name="name">hr.employee.list.with.actions</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="emp_id" string="Employee ID"/>
                </xpath>
            </field>
        </record>

        <!-- Server Action for Bulk Employee ID Generation -->
        <record id="action_bulk_generate_employee_ids" model="ir.actions.server">
            <field name="name">Generate Employee IDs</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="binding_model_id" ref="hr.model_hr_employee"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">
if records:
    action = records.action_bulk_generate_employee_ids()
else:
    action = {
        'type': 'ir.actions.client',
        'tag': 'display_notification',
        'params': {
            'title': 'Warning',
            'message': 'Please select employees first',
            'sticky': False,
            'type': 'warning',
        }
    }
            </field>
        </record>
    </data>
</odoo>
