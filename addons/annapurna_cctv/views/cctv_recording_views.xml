<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cctv_recording_list" model="ir.ui.view">
        <field name="name">cctv.recording.list</field>
        <field name="model">cctv.recording</field>
        <field name="arch" type="xml">
            <tree string="Recordings" default_order="timestamp desc">
                <field name="timestamp"/>
                <field name="camera_id"/>
                <field name="name"/>
                <field name="recording_type" widget="badge"/>
                <field name="duration" string="Duration (s)"/>
                <field name="notes"/>
                <field name="snapshot_data" column_invisible="1"/>
                <button name="action_download_snapshot" type="object"
                        string="Download" icon="fa-download"
                        invisible="not snapshot_data"/>
            </tree>
        </field>
    </record>

    <record id="view_cctv_recording_form" model="ir.ui.view">
        <field name="name">cctv.recording.form</field>
        <field name="model">cctv.recording</field>
        <field name="arch" type="xml">
            <form string="Recording">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="camera_id"/>
                        <field name="recording_type"/>
                        <field name="timestamp"/>
                        <field name="duration"/>
                        <field name="file_path"/>
                        <field name="notes"/>
                    </group>
                    <div class="text-center mt-3" invisible="not snapshot_data">
                        <field name="snapshot_data" widget="image"
                               options="{'size': [800, 600]}"/>
                        <button name="action_download_snapshot" type="object"
                                class="btn btn-primary mt-2">
                            <i class="fa fa-download"/> Download Snapshot
                        </button>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cctv_recording" model="ir.actions.act_window">
        <field name="name">Recordings &amp; Snapshots</field>
        <field name="res_model">cctv.recording</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
