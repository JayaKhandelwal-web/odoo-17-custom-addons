<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- ─── CCTV Dashboard Template ────────────────────────────────────────── -->
    <t t-name="annapurna_cctv.Dashboard">
        <div class="cctv_dashboard">

            <!-- Header -->
            <div class="cctv_dash_header">
                <div class="cctv_dash_title">
                    <i class="fa fa-video-camera"/> CCTV Dashboard
                </div>
                <div class="cctv_dash_stats">
                    <span class="cctv_stat online">
                        <i class="fa fa-circle"/> <t t-esc="onlineCount"/> Online
                    </span>
                    <span class="cctv_stat offline">
                        <i class="fa fa-circle"/> <t t-esc="offlineCount"/> Offline
                    </span>
                    <span class="cctv_stat total">
                        <i class="fa fa-camera"/> <t t-esc="totalCount"/> Total
                    </span>
                </div>
                <div class="cctv_dash_controls">
                    <span class="text-muted me-2">
                        <small>Last: <t t-esc="state.lastRefresh || 'Loading...'"/></small>
                    </span>
                    <div class="btn-group me-2">
                        <button class="btn btn-sm btn-outline-secondary"
                                t-att-class="state.gridCols === 1 ? 'active' : ''"
                                t-on-click="() => this.setGridCols(1)">
                            <i class="fa fa-square"/>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary"
                                t-att-class="state.gridCols === 2 ? 'active' : ''"
                                t-on-click="() => this.setGridCols(2)">
                            <i class="fa fa-th-large"/>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary"
                                t-att-class="state.gridCols === 3 ? 'active' : ''"
                                t-on-click="() => this.setGridCols(3)">
                            <i class="fa fa-th"/>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary"
                                t-att-class="state.gridCols === 4 ? 'active' : ''"
                                t-on-click="() => this.setGridCols(4)">
                            <i class="fa fa-th"/> 4
                        </button>
                    </div>
                    <button class="btn btn-sm btn-primary" t-on-click="checkAllStatus">
                        <i class="fa fa-refresh"/> Refresh All
                    </button>
                </div>
            </div>

            <!-- Loading -->
            <div t-if="state.loading" class="cctv_dash_loading">
                <i class="fa fa-spinner fa-spin fa-3x"/>
                <p>Loading cameras...</p>
            </div>

            <!-- No Cameras -->
            <div t-elif="state.cameras.length === 0" class="cctv_dash_empty">
                <i class="fa fa-video-camera fa-5x text-muted"/>
                <h4 class="mt-3">No cameras configured</h4>
                <p class="text-muted">Go to CCTV → Cameras to add your first camera.</p>
            </div>

            <!-- Camera Grid -->
            <div t-else=""
                 class="cctv_camera_grid"
                 t-att-style="'grid-template-columns: repeat(' + state.gridCols + ', 1fr);'">

                <t t-foreach="state.cameras" t-as="cam" t-key="cam.id">
                    <div class="cctv_camera_tile"
                         t-att-class="'cctv_tile_' + cam.status"
                         t-on-click="() => this.openCamera(cam.id)">

                        <!-- Status bar -->
                        <div class="cctv_tile_status_bar"
                             t-att-class="'status_' + cam.status">
                            <span class="cctv_status_dot"/>
                            <span t-esc="cam.status.toUpperCase()"/>
                            <span class="ms-auto" t-if="cam.location">
                                <i class="fa fa-map-marker"/> <t t-esc="cam.location"/>
                            </span>
                        </div>

                        <!-- Snapshot / Preview area -->
                        <div class="cctv_tile_preview">
                            <t t-if="cam.status === 'online' and cam.stream_type === 'snapshot_refresh'">
                                <img t-att-src="'/cctv/snapshot/' + cam.id + '?t=' + Date.now()"
                                     class="cctv_tile_img"
                                     t-att-alt="cam.name"/>
                            </t>
                            <t t-else="">
                                <div class="cctv_tile_placeholder"
                                     t-att-class="cam.status === 'online' ? 'cam_online_ph' : 'cam_offline_ph'">
                                    <i class="fa fa-video-camera fa-4x"/>
                                    <p t-if="cam.status === 'offline'">Camera Offline</p>
                                    <p t-elif="cam.status === 'online'">Click to Open Stream</p>
                                    <p t-else="">Status Unknown</p>
                                </div>
                            </t>
                        </div>

                        <!-- Camera info -->
                        <div class="cctv_tile_info">
                            <div class="cctv_tile_name">
                                <strong t-esc="cam.name"/>
                                <small class="text-muted ms-2" t-esc="cam.ip_address"/>
                            </div>
                            <div class="cctv_tile_actions" t-on-click.stop="() => true">
                                <button class="btn btn-xs btn-primary"
                                        t-on-click.stop="() => this.openStream(cam.id)"
                                        title="Open Live Stream">
                                    <i class="fa fa-play"/> Stream
                                </button>
                                <button class="btn btn-xs btn-secondary"
                                        t-on-click.stop="(ev) => this.takeSnapshot(cam.id, ev)"
                                        title="Take Snapshot">
                                    <i class="fa fa-camera"/>
                                </button>
                                <span t-if="cam.ptz_enabled"
                                      class="badge bg-info ms-1" title="PTZ Supported">
                                    PTZ
                                </span>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

    <!-- ─── Stream Player Template ──────────────────────────────────────────── -->
    <t t-name="annapurna_cctv.StreamPlayer">
        <div class="cctv_owl_player">
            <t t-if="state.loading">
                <div class="cctv_stream_overlay">
                    <i class="fa fa-spinner fa-spin fa-3x"/>
                    <p>Connecting to stream...</p>
                </div>
            </t>
            <t t-elif="state.error">
                <div class="cctv_stream_error">
                    <i class="fa fa-exclamation-triangle fa-3x text-warning"/>
                    <p t-esc="state.error"/>
                    <button class="btn btn-primary mt-2" t-on-click="reload">
                        <i class="fa fa-refresh"/> Retry
                    </button>
                </div>
            </t>
            <t t-else="">
                <video t-ref="videoEl" class="cctv_video_player"
                       controls="controls" autoplay="autoplay" muted="muted" playsinline="playsinline"/>
            </t>
        </div>
    </t>

</templates>
