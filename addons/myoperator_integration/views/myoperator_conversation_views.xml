<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Conversation Tree View -->
    <record id="view_myoperator_conversation_tree" model="ir.ui.view">
        <field name="name">myoperator.conversation.tree</field>
        <field name="model">myoperator.conversation</field>
        <field name="arch" type="xml">
            <tree string="Conversations" default_order="last_message_at desc">
                <field name="customer_name"/>
                <field name="customer_contact"/>
                <field name="partner_id"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'open'"
                       decoration-warning="status == 'assigned'"
                       decoration-success="status == 'resolved'"
                       decoration-muted="status == 'closed'"/>
                <field name="unread_count" widget="badge" decoration-danger="unread_count > 0"/>
                <field name="message_count"/>
                <field name="last_message_at"/>
                <field name="assigned_user_id"/>
                <button name="action_open_chat_interface" type="object" string="Open Chat"
                        icon="fa-comments" class="btn-sm btn-primary"/>
            </tree>
        </field>
    </record>

    <!-- Conversation Form View -->
    <record id="view_myoperator_conversation_form" model="ir.ui.view">
        <field name="name">myoperator.conversation.form</field>
        <field name="model">myoperator.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation">
                <header>
                    <button name="action_sync_messages" type="object" string="Sync Messages"
                            class="btn-secondary" icon="fa-refresh"/>
                    <button name="action_send_message" type="object" string="Send Message"
                            class="btn-primary" icon="fa-paper-plane"/>
                    <button name="action_assign_to_me" type="object" string="Assign to Me"
                            class="btn-warning" icon="fa-user"
                            invisible="assigned_user_id != False"/>
                    <button name="action_mark_resolved" type="object" string="Mark Resolved"
                            class="btn-success" icon="fa-check"
                            invisible="status == 'resolved'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="customer_info" string="Customer Information">
                            <field name="customer_name"/>
                            <field name="customer_contact"/>
                            <field name="partner_id"/>
                        </group>
                        <group name="conversation_info" string="Conversation Details">
                            <field name="conversation_id"/>
                            <field name="unread_count"/>
                            <field name="message_count"/>
                            <field name="last_message_at"/>
                        </group>
                    </group>
                    <group>
                        <group name="assignment" string="Assignment">
                            <field name="assigned_user_id"/>
                        </group>
                        <group name="system_info" string="System Info">
                            <field name="config_id"/>
                            <field name="synced_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Add notes about this conversation..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WhatsApp-like Chat Interface Form View -->
    <record id="view_myoperator_conversation_chat_form" model="ir.ui.view">
        <field name="name">myoperator.conversation.chat.form</field>
        <field name="model">myoperator.conversation</field>
        <field name="arch" type="xml">
            <form string="Chat Interface" class="o_myoperator_chat_form">
                <header>
                    <div class="o_chat_header">
                        <div class="o_chat_customer_info">
                            <h4><field name="customer_name" readonly="1"/></h4>
                            <span><field name="customer_contact" readonly="1"/></span>
                            <field name="status" widget="badge" readonly="1"/>
                        </div>
                        <div class="o_chat_actions">
                            <field name="assigned_user_id" invisible="1"/>
                            <button name="action_sync_messages" type="object" string="Refresh"
                                    class="btn-sm btn-outline-secondary" icon="fa-refresh"/>
                            <button name="action_assign_to_me" type="object" string="Assign"
                                    class="btn-sm btn-outline-warning" icon="fa-user"
                                    invisible="assigned_user_id != False"/>
                            <button name="action_mark_resolved" type="object" string="Resolve"
                                    class="btn-sm btn-outline-success" icon="fa-check"
                                    invisible="status == 'resolved'"/>
                        </div>
                    </div>
                </header>
                <sheet class="o_chat_sheet">
                    <div class="o_chat_container">
                        <!-- Messages Area -->
                        <div class="o_chat_messages">
                            <field name="message_ids" widget="chat_messages" nolabel="1" readonly="1">
                                <tree string="Messages" create="false" edit="false" delete="false">
                                    <field name="timestamp"/>
                                    <field name="direction"/>
                                    <field name="message_type"/>
                                    <field name="content"/>
                                    <field name="read_status"/>
                                </tree>
                            </field>
                        </div>

                        <!-- Send Message Area -->
                        <div class="o_chat_compose">
                            <button name="action_send_message" type="object" string="Send Message"
                                    class="btn-primary btn-lg" icon="fa-paper-plane"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Conversation Search View -->
    <record id="view_myoperator_conversation_search" model="ir.ui.view">
        <field name="name">myoperator.conversation.search</field>
        <field name="model">myoperator.conversation</field>
        <field name="arch" type="xml">
            <search string="Search Conversations">
                <field name="customer_name"/>
                <field name="customer_contact"/>
                <field name="partner_id"/>
                <field name="conversation_id"/>
                <separator/>
                <filter name="open" string="Open" domain="[('status', '=', 'open')]"/>
                <filter name="assigned" string="Assigned" domain="[('status', '=', 'assigned')]"/>
                <filter name="unread" string="Unread" domain="[('unread_count', '>', 0)]"/>
                <filter name="my_conversations" string="My Conversations"
                        domain="[('assigned_user_id', '=', uid)]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('last_message_at', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="this_week" string="This Week"
                        domain="[('last_message_at', '&gt;=', (datetime.datetime.now() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_assigned" string="Assigned User" context="{'group_by': 'assigned_user_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'last_message_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Conversation Action -->
    <record id="action_myoperator_conversation" model="ir.actions.act_window">
        <field name="name">WhatsApp Conversations</field>
        <field name="res_model">myoperator.conversation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_open': 0, 'search_default_this_week': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No conversations found!
            </p>
            <p>
                WhatsApp conversations will appear here once you sync with MyOperator or receive webhook notifications.
            </p>
        </field>
    </record>

    <!-- Message Tree View -->
    <record id="view_myoperator_message_tree" model="ir.ui.view">
        <field name="name">myoperator.message.tree</field>
        <field name="model">myoperator.message</field>
        <field name="arch" type="xml">
            <tree string="Messages" default_order="timestamp desc" create="false" edit="false">
                <field name="timestamp"/>
                <field name="conversation_id"/>
                <field name="direction" widget="badge"
                       decoration-info="direction == 'incoming'"
                       decoration-success="direction == 'outgoing'"/>
                <field name="message_type"/>
                <field name="content"/>
                <field name="read_status" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Message Action -->
    <record id="action_myoperator_message" model="ir.actions.act_window">
        <field name="name">Chat Messages</field>
        <field name="res_model">myoperator.message</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_this_week': 1}</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_myoperator_conversations" name="Conversations" 
              parent="menu_myoperator_chat"
              action="action_myoperator_conversation" sequence="10"/>
    <menuitem id="menu_myoperator_messages" name="All Messages" 
              parent="menu_myoperator_chat"
              action="action_myoperator_message" sequence="20"/>
</odoo>