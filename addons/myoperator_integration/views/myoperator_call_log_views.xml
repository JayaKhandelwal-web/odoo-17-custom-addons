<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MyOperator Call Log Form View -->
    <record id="view_myoperator_call_log_form" model="ir.ui.view">
        <field name="name">myoperator.call.log.form</field>
        <field name="model">myoperator.call.log</field>
        <field name="arch" type="xml">
            <form string="Call Log">
                <header>
                    <button name="action_view_recording" type="object" string="View Recording" 
                            class="btn-primary" icon="fa-play-circle" 
                            invisible="recording_url == False"/>
                    <button name="action_call_back" type="object" string="Quick Call Back"
                            class="btn-warning" icon="fa-phone"
                            invisible="caller_number == False and called_number == False"/>
                    <button name="action_advanced_callback" type="object" string="Advanced Callback"
                            class="btn-info" icon="fa-phone-square"
                            invisible="caller_number == False and called_number == False"/>
                    <button name="action_create_lead" type="object" string="Create Lead"
                            class="btn-secondary" icon="fa-plus"
                            invisible="caller_partner_id != False"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="call_details" string="Call Details">
                            <field name="call_id"/>
                            <field name="call_type"/>
                            <field name="timestamp"/>
                            <field name="duration_formatted"/>
                        </group>
                        <group name="numbers" string="Phone Numbers">
                            <field name="caller_number"/>
                            <field name="called_number"/>
                        </group>
                    </group>
                    <group>
                        <group name="contacts" string="Related Contacts">
                            <field name="caller_partner_id"/>
                            <field name="called_partner_id"/>
                        </group>
                        <group name="system" string="System Info">
                            <field name="config_id"/>
                            <field name="synced_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="recording_url" widget="url"/>
                    </group>
                    <group>
                        <field name="notes" placeholder="Add notes about this call..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- MyOperator Call Log Tree View -->
    <record id="view_myoperator_call_log_tree" model="ir.ui.view">
        <field name="name">myoperator.call.log.tree</field>
        <field name="model">myoperator.call.log</field>
        <field name="arch" type="xml">
            <tree string="Call Logs" default_order="timestamp desc">
                <field name="timestamp"/>
                <field name="call_type" widget="badge"
                       decoration-info="call_type == 'inbound'"
                       decoration-warning="call_type == 'outbound'"
                       decoration-muted="call_type == 'internal'"/>
                <field name="caller_number"/>
                <field name="called_number"/>
                <field name="caller_partner_id"/>
                <field name="called_partner_id"/>
                <field name="duration_formatted"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'answered'"
                       decoration-danger="status == 'missed'"
                       decoration-warning="status == 'busy'"/>
                <field name="recording_url" widget="boolean" string="Recording"/>
                <button name="action_call_back" type="object" string="Call Back"
                        icon="fa-phone" class="btn-sm btn-outline-primary"
                        invisible="caller_number == False and called_number == False"/>
            </tree>
        </field>
    </record>

    <!-- MyOperator Call Log Search View -->
    <record id="view_myoperator_call_log_search" model="ir.ui.view">
        <field name="name">myoperator.call.log.search</field>
        <field name="model">myoperator.call.log</field>
        <field name="arch" type="xml">
            <search string="Search Call Logs">
                <field name="caller_number"/>
                <field name="called_number"/>
                <field name="caller_partner_id"/>
                <field name="called_partner_id"/>
                <field name="call_id"/>
                <separator/>
                <filter name="inbound" string="Inbound" domain="[('call_type', '=', 'inbound')]"/>
                <filter name="outbound" string="Outbound" domain="[('call_type', '=', 'outbound')]"/>
                <filter name="answered" string="Answered" domain="[('status', '=', 'answered')]"/>
                <filter name="missed" string="Missed" domain="[('status', '=', 'missed')]"/>
                <filter name="with_recording" string="With Recording" domain="[('recording_url', '!=', False)]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('timestamp', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="this_week" string="This Week" domain="[('timestamp', '&gt;=', (datetime.datetime.now() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="this_month" string="This Month" domain="[('timestamp', '&gt;=', (datetime.datetime.now().replace(day=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_type" string="Call Type" context="{'group_by': 'call_type'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'timestamp:day'}"/>
                    <filter name="group_by_caller" string="Caller" context="{'group_by': 'caller_partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- MyOperator Call Log Action -->
    <record id="action_myoperator_call_log" model="ir.actions.act_window">
        <field name="name">Call Logs</field>
        <field name="res_model">myoperator.call.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_this_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No call logs found!
            </p>
            <p>
                Call logs will appear here once you sync with MyOperator or receive webhook notifications.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_myoperator_call_logs" name="Call Logs" parent="menu_myoperator_root" 
              action="action_myoperator_call_log" sequence="20"/>
</odoo>