<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sync Call Logs Wizard Form -->
    <record id="view_sync_call_logs_wizard_form" model="ir.ui.view">
        <field name="name">sync.call.logs.wizard.form</field>
        <field name="model">sync.call.logs.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Call Logs">
                <group>
                    <field name="config_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="limit"/>
                </group>
                <footer>
                    <button name="action_sync" type="object" string="Sync Now" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Sync Call Logs Wizard Action -->
    <record id="action_sync_call_logs_wizard" model="ir.actions.act_window">
        <field name="name">Sync Call Logs</field>
        <field name="res_model">sync.call.logs.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_sync_call_logs" name="Sync Call Logs" parent="menu_myoperator_root" 
              action="action_sync_call_logs_wizard" sequence="40"/>
</odoo>