<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Interakt User Group -->
        <record id="group_interakt_user" model="res.groups">
            <field name="name">Interakt User</field>
            <field name="category_id" ref="base.module_category_marketing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Interakt Manager Group -->
        <record id="group_interakt_manager" model="res.groups">
            <field name="name">Interakt Manager</field>
            <field name="category_id" ref="base.module_category_marketing"/>
            <field name="implied_ids" eval="[(4, ref('group_interakt_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>