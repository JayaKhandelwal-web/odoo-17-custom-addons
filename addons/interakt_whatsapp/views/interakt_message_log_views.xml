<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Interakt Message Log Form View -->
    <record id="view_interakt_message_log_form" model="ir.ui.view">
        <field name="name">interakt.message.log.form</field>
        <field name="model">interakt.message.log</field>
        <field name="arch" type="xml">
            <form string="Message Log" create="false" delete="false">
                <header>
                    <field name="status" widget="statusbar"/>
                    <button name="action_open_related_record" string="Open Related Record"
                            type="object" class="oe_highlight"
                            invisible="not model_name or not res_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="message_id" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Recipient">
                            <field name="recipient_name"/>
                            <field name="country_code"/>
                            <field name="phone_number"/>
                        </group>
                        <group string="Message Details">
                            <field name="template_id"/>
                            <field name="template_name"/>
                            <field name="config_id"/>
                        </group>
                    </group>

                    <group string="Template Data">
                        <field name="body_values" widget="text"/>
                        <field name="header_url"/>
                        <field name="callback_data"/>
                    </group>

                    <group string="Delivery Info">
                        <group>
                            <field name="sent_date"/>
                            <field name="delivered_date"/>
                            <field name="read_date"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="res_id"/>
                        </group>
                    </group>

                    <group string="Error Details" invisible="status != 'failed'">
                        <field name="error_message" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Interakt Message Log Tree View -->
    <record id="view_interakt_message_log_tree" model="ir.ui.view">
        <field name="name">interakt.message.log.tree</field>
        <field name="model">interakt.message.log</field>
        <field name="arch" type="xml">
            <tree decoration-success="status == 'sent'"
                  decoration-info="status == 'delivered'"
                  decoration-danger="status == 'failed'"
                  decoration-muted="status == 'pending'"
                  create="false" delete="false">
                <field name="create_date"/>
                <field name="template_name"/>
                <field name="recipient_name"/>
                <field name="phone_number"/>
                <field name="message_id"/>
                <field name="status"/>
                <field name="sent_date"/>
            </tree>
        </field>
    </record>

    <!-- Interakt Message Log Search View -->
    <record id="view_interakt_message_log_search" model="ir.ui.view">
        <field name="name">interakt.message.log.search</field>
        <field name="model">interakt.message.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message_id"/>
                <field name="recipient_name"/>
                <field name="phone_number"/>
                <field name="template_name"/>
                <separator/>
                <filter string="Sent" name="status_sent" domain="[('status', '=', 'sent')]"/>
                <filter string="Delivered" name="status_delivered" domain="[('status', '=', 'delivered')]"/>
                <filter string="Failed" name="status_failed" domain="[('status', '=', 'failed')]"/>
                <filter string="Pending" name="status_pending" domain="[('status', '=', 'pending')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('create_date', '&gt;=', datetime.datetime.now().replace(hour=0, minute=0, second=0))]"/>
                <filter string="Last 7 Days" name="last_7_days"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Template" name="group_template" context="{'group_by': 'template_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Interakt Message Log Action -->
    <record id="action_interakt_message_log" model="ir.actions.act_window">
        <field name="name">Message Logs</field>
        <field name="res_model">interakt.message.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No messages sent yet
            </p>
            <p>
                Message logs will appear here when you send WhatsApp templates.
            </p>
        </field>
    </record>
</odoo>