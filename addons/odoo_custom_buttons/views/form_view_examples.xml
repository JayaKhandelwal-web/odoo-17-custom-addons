<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        EXAMPLE: How to add custom buttons to specific form views
        
        Copy this pattern for each model where you want to add the buttons.
        The buttons will work universally by inheriting the base model.
        
        To apply to ALL form views, you'll need to inherit each form view individually
        or use a more advanced approach with automated view inheritance.
    -->

    <!-- Example 1: Add buttons to res.partner (Contacts) form view -->
    <record id="view_partner_form_custom_buttons" model="ir.ui.view">
        <field name="name">res.partner.form.custom.buttons</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="o_form_custom_buttons_container">
                    <button name="action_custom_save" 
                            string="SAVE" 
                            type="object" 
                            class="o_form_custom_button o_form_button_save">
                        <i class="fa fa-save"/> SAVE
                    </button>
                    
                    <button name="action_custom_delete" 
                            string="DELETE" 
                            type="object" 
                            class="o_form_custom_button o_form_button_delete"
                            confirm="Are you sure you want to delete this contact?">
                        <i class="fa fa-trash"/> DELETE
                    </button>
                    
                    <button name="action_custom_back" 
                            string="BACK" 
                            type="object" 
                            class="o_form_custom_button o_form_button_back">
                        <i class="fa fa-arrow-left"/> BACK
                    </button>
                </div>
            </xpath>
        </field>
    </record>

