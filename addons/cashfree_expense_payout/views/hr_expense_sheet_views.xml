<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Expense Sheet Form View Inheritance ══════════════════════════════ -->
    <record id="view_hr_expense_sheet_cashfree" model="ir.ui.view">
        <field name="name">hr.expense.sheet.cashfree.payout</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">

            <!-- ── Declare all custom fields used in invisible conditions ── -->
            <xpath expr="//field[@name='can_reset']" position="before">
                <field name="cashfree_payout_state" invisible="1"/>
                <field name="cashfree_payout_reference" invisible="1"/>
                <field name="cashfree_transfer_id" invisible="1"/>
                <field name="cashfree_state_label" invisible="1"/>
                <field name="cashfree_utr" invisible="1"/>
                <field name="cashfree_failure_reason" invisible="1"/>
                <field name="cashfree_bank_verified" invisible="1"/>
                <field name="cashfree_verified_name" invisible="1"/>
                <field name="cashfree_verify_message" invisible="1"/>
            </xpath>

            <!-- ── Cashfree Buttons ── -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- Verify Bank Account Button (shown when not yet verified) -->
                <button
                    name="action_verify_bank_account"
                    type="object"
                    string="Verify Bank Account"
                    icon="fa-university"
                    class="oe_stat_button"
                    invisible="cashfree_bank_verified == 'verified'"
                    confirm="This will verify the employee bank account details via Cashfree. Proceed?"
                />
                <!-- Re-verify button (shown when already verified) -->
                <button
                    name="action_verify_bank_account"
                    type="object"
                    string="Re-verify Bank"
                    icon="fa-check-circle"
                    class="oe_stat_button"
                    invisible="cashfree_bank_verified != 'verified'"
                />
                <!-- Pay via Cashfree Button -->
                <button
                    name="action_cashfree_pay"
                    type="object"
                    string="Pay via Cashfree"
                    icon="fa-money"
                    class="oe_stat_button"
                    invisible="state != 'post' or cashfree_payout_state == 'success'"
                    confirm="Are you sure you want to initiate Cashfree payout for this expense sheet?"
                />
                <button
                    name="action_cashfree_refresh_status"
                    type="object"
                    string="Refresh Payout Status"
                    icon="fa-refresh"
                    class="oe_stat_button"
                    invisible="cashfree_payout_state != 'pending'"
                />
            </xpath>

            <!-- ── Status Banners ── -->
            <xpath expr="//sheet" position="before">
                <!-- Bank Verification Banners -->
                <div class="alert alert-success mb-0" role="alert"
                     invisible="cashfree_bank_verified != 'verified'">
                    <strong>✅ Bank Account Verified</strong>
                    — Account holder confirmed:
                    <field name="cashfree_verified_name" readonly="1"/>
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="cashfree_bank_verified != 'failed'">
                    <strong>❌ Bank Account Verification Failed</strong>
                    — <field name="cashfree_verify_message" readonly="1"/>
                    <br/>Check account number and IFSC, then click "Verify Bank Account" to retry.
                </div>
                <!-- Payout Banners -->
                <div class="alert alert-success mb-0" role="alert"
                     invisible="cashfree_payout_state != 'success'">
                    <strong>✅ Cashfree Payout Successful</strong>
                    — Amount transferred. UTR: <field name="cashfree_utr" readonly="1"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="cashfree_payout_state != 'pending'">
                    <strong>Cashfree Payout Pending</strong>
                    — Transfer is being processed by the bank.
                    Ref: <field name="cashfree_payout_reference" readonly="1"/>
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="cashfree_payout_state != 'failed'">
                    <strong>❌ Cashfree Payout Failed</strong>
                    — <field name="cashfree_failure_reason" readonly="1"/>
                    <br/>Click "Pay via Cashfree" to retry.
                </div>
            </xpath>

            <!-- ── Cashfree Info Tab ── -->
            <xpath expr="//notebook" position="inside">
                <page string="Cashfree Payout" name="cashfree_payout"
                      invisible="cashfree_payout_state == 'not_initiated' and cashfree_bank_verified == 'not_verified'">
                    <!-- Bank Verification Section -->
                    <group string="Bank Account Verification">
                        <group>
                            <field name="cashfree_bank_verified" string="Verification Status" readonly="1"/>
                            <field name="cashfree_verified_name" string="Verified Name at Bank" readonly="1"/>
                        </group>
                        <group>
                            <field name="cashfree_verify_message" string="Verification Message" readonly="1"/>
                        </group>
                    </group>
                    <!-- Payout Transfer Section -->
                    <group string="Cashfree Transfer Details"
                           invisible="cashfree_payout_state == 'not_initiated'">
                        <group>
                            <field name="cashfree_state_label" string="Payout Status" readonly="1"/>
                            <field name="cashfree_payout_reference" string="Transfer Reference" readonly="1"/>
                            <field name="cashfree_transfer_id" string="Cashfree Transfer ID" readonly="1"/>
                        </group>
                        <group>
                            <field name="cashfree_utr" string="UTR Number" readonly="1"/>
                            <field name="cashfree_failure_reason" string="Failure Reason" readonly="1"
                                   invisible="cashfree_payout_state != 'failed'"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>